---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Calculator from '../components/home/Calculator.astro';
import Packages from '../components/home/Packages.astro';
import EnergyFlow from '../components/home/EnergyFlow.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { useT, type Locale, type RouteKey } from '../i18n';
import { breadcrumbLd } from '../lib/seo';
interface Props { lang: Locale; route: RouteKey }
const { lang, route } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} route={route} title={t.meta.calculator.title} description={t.meta.calculator.description}
  jsonLd={[breadcrumbLd(lang, [{ name: t.nav.home, key: 'home' }, { name: t.nav.calculator, key: 'calculator' }])]}>
  <PageHero lang={lang} eyebrow={t.calc.eyebrow} title={t.pages.h1.calculator} lead={t.calc.lead} crumb={t.nav.calculator} cta={false} />
  <Calculator lang={lang} />
  <Packages lang={lang} />
  <EnergyFlow lang={lang} />
  <FinalCta lang={lang} source="calculator" />
</Base>
