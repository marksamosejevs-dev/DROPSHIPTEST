---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/home/FaqList.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { useT, type Locale, type RouteKey } from '../i18n';
import { breadcrumbLd, faqLd } from '../lib/seo';
interface Props { lang: Locale; route: RouteKey }
const { lang, route } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} route={route} title={t.meta.faq.title} description={t.meta.faq.description}
  jsonLd={[faqLd(lang), breadcrumbLd(lang, [{ name: t.nav.home, key: 'home' }, { name: t.faq.title, key: 'faq' }])]}>
  <PageHero lang={lang} eyebrow={t.faq.eyebrow} title={t.pages.h1.faq} lead={t.faq.lead} crumb={t.faq.title} />
  <FaqList lang={lang} />
  <FinalCta lang={lang} source="faq" />
</Base>
