---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import WhyAidex from '../components/home/WhyAidex.astro';
import Packages from '../components/home/Packages.astro';
import Calculator from '../components/home/Calculator.astro';
import DayNight from '../components/home/DayNight.astro';
import Hotspots from '../components/home/Hotspots.astro';
import SupportSection from '../components/home/SupportSection.astro';
import Process from '../components/home/Process.astro';
import ProjectsGrid from '../components/home/ProjectsGrid.astro';
import Testimonials from '../components/home/Testimonials.astro';
import B2B from '../components/home/B2B.astro';
import FaqList from '../components/home/FaqList.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { useT, type Locale, type RouteKey } from '../i18n';
import { serviceLd } from '../lib/seo';
interface Props { lang: Locale; route: RouteKey }
const { lang, route } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} route={route} title={t.meta.home.title} description={t.meta.home.description} jsonLd={[serviceLd(lang, t.nav.solar, t.meta.solar.description, 'solar')]}>
  <Hero lang={lang} />
  <Packages lang={lang} />
  <Hotspots lang={lang} />
  <DayNight lang={lang} />
  <Calculator lang={lang} />
  <WhyAidex lang={lang} />
  <SupportSection lang={lang} />
  <Process lang={lang} />
  <ProjectsGrid lang={lang} limit={3} />
  <Testimonials lang={lang} />
  <B2B lang={lang} compact />
  <FaqList lang={lang} limit={6} />
  <FinalCta lang={lang} />
</Base>
