---
/** Case-study page generated from one entry in src/data/projects.ts. */
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ProjectsGrid from '../components/home/ProjectsGrid.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { useT, path, locales, type Locale } from '../i18n';
import { projectPhotos, type Project } from '../data/projects';
import { projectPath, projectLocation, projectTitle, projectSpecs } from '../lib/projects';
import { abs } from '../lib/seo';
interface Props { lang: Locale; project: Project }
const { lang, project: p } = Astro.props;
const t = useT(lang);
const d = t.projects.detail;
const photos = projectPhotos(p);
const [cover, ...rest] = photos;
const title = `${projectLocation(p, lang)}: ${projectTitle(p, lang)}`;
const specs = projectSpecs(p, lang);
const paths = Object.fromEntries(locales.map((l) => [l, projectPath(p, l)])) as Record<Locale, string>;
const description = p.summary?.[lang] ?? `${title}. ${specs.map((s) => `${s.k}: ${s.v}`).join(', ')}.`;
const story = p.story ? ([['challenge', d.challenge], ['solution', d.solution], ['result', d.result]] as const).filter(([k]) => p.story?.[k]) : [];
const crumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.nav.home, item: abs(path('home', lang)) },
    { '@type': 'ListItem', position: 2, name: t.nav.projects, item: abs(path('projects', lang)) },
    { '@type': 'ListItem', position: 3, name: title, item: abs(paths[lang]) },
  ],
};
---
<Base lang={lang} route={null} paths={paths} title={`${title} | AIDEX`} description={description} jsonLd={[crumbs]} noindex={!!p.sample} headerTone="light">
  <section class="pd" aria-labelledby="page-title">
    <div class="container">
      <nav class="pd__crumbs" aria-label={t.nav.breadcrumb}>
        <ol>
          <li><a href={path('home', lang)}>{t.nav.home}</a></li>
          <li><a href={path('projects', lang)}>{t.nav.projects}</a></li>
          <li aria-current="page">{projectLocation(p, lang)}</li>
        </ol>
      </nav>
      <div class="pd__head">
        <p class="pd__loc"><Icon name="pin" size={18} />{projectLocation(p, lang)} · {t.projects.segments[p.segment]}</p>
        <h1 id="page-title">{projectTitle(p, lang)}</h1>
        {p.summary && <p class="pd__lead">{p.summary[lang]}</p>}
      </div>
      <figure class="pd__cover">
        <Picture src={cover.src} alt={cover.alt?.[lang] ?? title} sizes="(min-width: 1320px) 1240px, 100vw" widths={[640, 960, 1280, 1920, 2400]} eager />
        {p.sample && <span class="dev-flag pd__flag">{t.example}</span>}
      </figure>
      <div class:list={['pd__grid', story.length === 0 && 'pd__grid--solo']}>
        <dl class="pd__specs" aria-label={d.system}>
          <p class="pd__h">{d.system}</p>
          {specs.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
        </dl>
        {story.length > 0 && (
          <div class="pd__story">
            {story.map(([k, label]) => <section><h2>{label}</h2><p>{p.story![k]![lang]}</p></section>)}
          </div>
        )}
      </div>
      {rest.length > 0 && (
        <section class="pd__gallery" aria-label={d.gallery}>
          <ul>
            {rest.map((ph) => <li><figure><Picture src={ph.src} alt={ph.alt?.[lang] ?? title} sizes="(min-width: 900px) 50vw, 100vw" widths={[480, 800, 1200, 1600]} /></figure></li>)}
          </ul>
        </section>
      )}
      <p class="pd__back"><a href={path('projects', lang)} class="link-arrow">{d.back}<Icon name="arrow" /></a></p>
    </div>
  </section>
  <ProjectsGrid lang={lang} limit={3} exclude={p.slug} />
  <FinalCta lang={lang} source={`project-${p.slug}`} />
</Base>
<style>
  .pd { padding: calc(var(--hdr-total) + 40px) 0 clamp(56px, 7vw, 96px); background: #fff; }
  .pd__crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; font-size: .875rem; color: var(--muted); }
  .pd__crumbs li + li::before { content: '/'; margin-right: 6px; opacity: .5; }
  .pd__crumbs a { color: inherit; }
  .pd__head { display: grid; gap: 12px; max-width: 820px; margin: 28px 0 32px; }
  .pd__loc { display: flex; align-items: center; gap: 6px; font-weight: 600; color: var(--brand); }
  .pd__head h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); letter-spacing: -0.035em; line-height: 1.05; }
  .pd__lead { font-size: clamp(1.05rem, 1.4vw, 1.25rem); color: var(--muted); max-width: 60ch; }
  .pd__cover { position: relative; margin: 0; border-radius: var(--r-xl); overflow: hidden; aspect-ratio: 16 / 9; background: var(--bg-2); }
  .pd__cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pd__flag { position: absolute; top: 18px; left: 18px; }
  .pd__grid { display: grid; gap: 32px; margin-top: 40px; }
  @media (min-width: 900px) { .pd__grid { grid-template-columns: minmax(300px, 380px) 1fr; gap: 64px; } }
  .pd__grid--solo { grid-template-columns: 1fr !important; }
  .pd__grid--solo .pd__specs { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); column-gap: 32px; }
  .pd__grid--solo .pd__h { grid-column: 1 / -1; }
  .pd__grid--solo .pd__specs div { flex-direction: column; gap: 4px; }
  .pd__grid--solo .pd__specs dd { text-align: left; font-size: 1.125rem; }
  .pd__h { font-family: var(--font-display); font-weight: 750; font-size: 1.25rem; margin-bottom: 8px; }
  .pd__specs { display: grid; align-content: start; padding: 24px; border-radius: var(--r-lg); background: var(--bg); }
  .pd__specs div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); }
  .pd__specs dt { color: var(--muted); }
  .pd__specs dd { font-weight: 600; text-align: right; }
  .pd__story { display: grid; gap: 28px; align-content: start; }
  .pd__story h2 { font-size: 1.35rem; margin-bottom: 6px; }
  .pd__story p { color: var(--muted); font-size: 1.0625rem; max-width: 64ch; }
  .pd__gallery ul { list-style: none; display: grid; gap: 16px; margin-top: 40px; }
  @media (min-width: 720px) { .pd__gallery ul { grid-template-columns: 1fr 1fr; } }
  .pd__gallery figure { margin: 0; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 4 / 3; }
  .pd__gallery :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .pd__back { margin-top: 36px; }
</style>
