---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectsGrid from '../components/home/ProjectsGrid.astro';
import Testimonials from '../components/home/Testimonials.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { useT, type Locale, type RouteKey } from '../i18n';
import { breadcrumbLd } from '../lib/seo';
interface Props { lang: Locale; route: RouteKey }
const { lang, route } = Astro.props;
const t = useT(lang);
---
<Base lang={lang} route={route} title={t.meta.projects.title} description={t.meta.projects.description}
  jsonLd={[breadcrumbLd(lang, [{ name: t.nav.home, key: 'home' }, { name: t.nav.projects, key: 'projects' }])]}>
  <PageHero lang={lang} eyebrow={t.projects.eyebrow} title={t.pages.h1.projects} lead={t.projects.lead} crumb={t.nav.projects} />
  <ProjectsGrid lang={lang} filter />
  <Testimonials lang={lang} />
  <FinalCta lang={lang} source="projects" />
</Base>
