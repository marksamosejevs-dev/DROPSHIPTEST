---
interface Props { eyebrow?: string; title: string; lead?: string; split?: boolean; id?: string; level?: 1 | 2 }
const { eyebrow, title, lead, split = false, id, level = 2 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---
<div class:list={['s-head', split && 's-head--split']}>
  <div class="s-head__main" data-reveal>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H id={id} class="s-head__title">{title}</H>
  </div>
  {(lead || Astro.slots.has('default')) && (
    <div class="s-head__aside" data-reveal style="--d:.08s">
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  )}
</div>

<style>
  .s-head__main { display: grid; gap: 18px; }
  .s-head__aside { display: grid; gap: 22px; justify-items: start; }
  .s-head__aside .lead { color: var(--muted); max-width: 58ch; }
  :global(.dark) .s-head__aside .lead { color: rgba(238, 241, 236, 0.7); }
</style>
