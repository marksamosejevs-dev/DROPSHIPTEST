---
/**
 * Renders a company config value. A value that is still a placeholder renders a
 * marker carrying [data-placeholder]; with dev markers off (default) the marker and
 * its surrounding row are hidden by CSS, so visitors never see "[to be confirmed]".
 */
import { isPlaceholder, type Field } from '../config/company';
import { useT, type Locale } from '../i18n';
interface Props { value: Field; lang: Locale }
const { value, lang } = Astro.props;
const t = useT(lang);
---
{isPlaceholder(value) ? <span class="ph" title={value.note} data-placeholder>[{t.tbc}]</span> : <>{value}</>}
