---
/**
 * Official AIDEX wordmark (public/aidex-logo.svg, vectorised from the logo
 * supplied by AIDEX). Drawn as a CSS mask filled with currentColor so a single
 * cached file serves every tone: brand green #395723 on light backgrounds,
 * white on dark ones (header over the hero, footer).
 */
interface Props { class?: string; tone?: 'dark' | 'light'; sub?: string }
const { class: cls, tone = 'dark', sub } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, cls]}>
  <span class="logo__img" aria-hidden="true"></span>
  <span class="sr-only">AIDEX</span>
  {sub && <span class="logo__sub">{sub}</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; line-height: 1; color: #395723; }
  .logo--light { color: #fff; }
  .logo__img {
    display: block; flex: none; width: 112px; aspect-ratio: 2984 / 840; background: currentColor;
    -webkit-mask: url('/aidex-logo.svg') center / contain no-repeat; mask: url('/aidex-logo.svg') center / contain no-repeat;
  }
  .logo__sub { font-size: .75rem; font-weight: 500; letter-spacing: .02em; opacity: .75; padding-left: 12px; border-left: 1px solid currentColor; line-height: 1.3; max-width: 9ch; }
</style>
