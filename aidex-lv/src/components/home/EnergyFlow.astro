---
import SectionHead from '../SectionHead.astro';
import { useT, type Locale } from '../../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const f = t.flow;
// Node positions in the 600×480 diagram
const N = { sun: [96, 92], panels: [300, 92], home: [300, 262], battery: [110, 398], grid: [490, 398] } as const;
const flows = {
  day: [
    { id: 'd1', d: `M${N.sun[0] + 40} ${N.sun[1]} L${N.panels[0] - 46} ${N.panels[1]}` },
    { id: 'd2', d: `M${N.panels[0]} ${N.panels[1] + 44} L${N.home[0]} ${N.home[1] - 48}` },
    { id: 'd3', d: `M${N.home[0] - 40} ${N.home[1] + 30} L${N.battery[0] + 36} ${N.battery[1] - 30}` },
    { id: 'd4', d: `M${N.home[0] + 40} ${N.home[1] + 30} L${N.grid[0] - 36} ${N.grid[1] - 30}` },
  ],
  night: [
    { id: 'n1', d: `M${N.battery[0] + 36} ${N.battery[1] - 30} L${N.home[0] - 40} ${N.home[1] + 30}` },
  ],
};
---
<section class="section dark dark--spruce flow" aria-labelledby="flow-title" data-flow data-mode="day">
  <div class="container flow__grid">
    <div class="flow__copy">
      <SectionHead eyebrow={f.eyebrow} title={f.title} lead={f.lead} id="flow-title" />
      <div class="flow__seg" role="radiogroup" aria-label={`${f.day} / ${f.night}`}>
        <button type="button" role="radio" aria-checked="true" data-flow-btn="day">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" stroke-linecap="round" /></svg>
          {f.day}
        </button>
        <button type="button" role="radio" aria-checked="false" data-flow-btn="night">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" stroke-linejoin="round" /></svg>
          {f.night}
        </button>
        <span class="flow__progress" aria-hidden="true"><span></span></span>
      </div>
      <ol class="flow__steps" data-variant="day">
        {f.dayCaption.map((s, i) => <li><span class="tnum">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
      </ol>
      <ol class="flow__steps" data-variant="night">
        {f.nightCaption.map((s, i) => <li><span class="tnum">{String(i + 1).padStart(2, '0')}</span>{s}</li>)}
      </ol>
    </div>

    <figure class="flow__fig" data-reveal>
      <svg class="flow__svg" viewBox="0 0 600 480" role="img" aria-labelledby="flow-svg-title">
        <title id="flow-svg-title">{f.title}</title>
        <defs>
          <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f7d58a" stop-opacity=".55" />
            <stop offset="100%" stop-color="#f7d58a" stop-opacity="0" />
          </radialGradient>
          {[...flows.day, ...flows.night].map((p) => <path id={`fp-${p.id}`} d={p.d} />)}
        </defs>

        <!-- static guide lines -->
        <g class="guides">
          {[...flows.day].map((p) => <path d={p.d} />)}
        </g>

        <!-- animated flows -->
        <g class="flows flows--day">
          {flows.day.map((p, i) => (
            <g>
              <path d={p.d} class="flow-line" style={`--delay:${i * 0.35}s`} />
              {[0, 1, 2].map((k) => (
                <circle r="3.4" class="dot" visibility="hidden">
                  <set attributeName="visibility" to="visible" begin={`${i * 0.35 + k * 0.8}s`} />
                  <animateMotion dur="2.4s" repeatCount="indefinite" begin={`${i * 0.35 + k * 0.8}s`}><mpath href={`#fp-${p.id}`} /></animateMotion>
                </circle>
              ))}
            </g>
          ))}
        </g>
        <g class="flows flows--night">
          {flows.night.map((p) => (
            <g>
              <path d={p.d} class="flow-line" />
              {[0, 1, 2].map((k) => (
                <circle r="3.4" class="dot" visibility="hidden">
                  <set attributeName="visibility" to="visible" begin={`${k * 0.8}s`} />
                  <animateMotion dur="2.4s" repeatCount="indefinite" begin={`${k * 0.8}s`}><mpath href={`#fp-${p.id}`} /></animateMotion>
                </circle>
              ))}
            </g>
          ))}
          <path d={`M${N.grid[0] - 36} ${N.grid[1] - 30} L${N.home[0] + 40} ${N.home[1] + 30}`} class="flow-line flow-line--standby" />
        </g>

        <!-- nodes -->
        <g class="node node--sun" transform={`translate(${N.sun[0]} ${N.sun[1]})`}>
          <circle r="70" fill="url(#sunGlow)" class="sun-glow" />
          <circle r="38" class="node__disc" />
          <g class="sun-icon"><circle r="11" /><path d="M0-22v5M0 17v5M-22 0h5M17 0h5M-15.5-15.5l3.5 3.5M12 12l3.5 3.5M-15.5 15.5l3.5-3.5M12-12l3.5-3.5" /></g>
          <path class="moon-icon" d="M9 5A13 13 0 1 1-4-12 10 10 0 0 0 9 5z" />
          <text y="64" class="node__label">{f.nodes.sun}</text>
        </g>
        <g class="node node--panels" transform={`translate(${N.panels[0]} ${N.panels[1]})`}>
          <circle r="44" class="node__disc" />
          <g class="node__icon"><path d="M-22 12-14-12h30L22 12z" /><path d="M-18 0h36M-5-12-9 12M5-12 9 12" /></g>
          <text y="70" class="node__label">{f.nodes.panels}</text>
        </g>
        <g class="node node--home" transform={`translate(${N.home[0]} ${N.home[1]})`}>
          <circle r="52" class="node__disc node__disc--home" />
          <g class="node__icon node__icon--home"><path d="M-24 2 0-20 24 2" /><path d="M-18-3v25h36V-3" /><path d="M-6 22V8h12v14" /><rect x="-5" y="-6" width="10" height="7" class="win" /></g>
          <text y="80" class="node__label">{f.nodes.home}</text>
        </g>
        <g class="node node--battery" transform={`translate(${N.battery[0]} ${N.battery[1]})`}>
          <circle r="40" class="node__disc" />
          <g class="node__icon"><rect x="-12" y="-19" width="24" height="38" rx="3" /><path d="M-5-23h10" /></g>
          <rect x="-8" y="-15" width="16" height="30" rx="1.5" class="charge" />
          <text y="66" class="node__label">{f.nodes.battery}</text>
        </g>
        <g class="node node--grid" transform={`translate(${N.grid[0]} ${N.grid[1]})`}>
          <circle r="40" class="node__disc" />
          <g class="node__icon"><path d="M-10 20-4-20h8L10 20M-6 0H6M-14-12h28M-8 10H8" /></g>
          <text y="66" class="node__label">{f.nodes.grid}</text>
        </g>
      </svg>
    </figure>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-flow-btn]');
    const svg = root.querySelector<SVGSVGElement>('svg');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) svg?.pauseAnimations();
    let timer: number | undefined;
    const set = (m: string) => {
      root.dataset.mode = m;
      btns.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.flowBtn === m)));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } root.classList.add('is-manual'); };
    btns.forEach((b) => b.addEventListener('click', () => { stop(); set(b.dataset.flowBtn!); }));
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !timer && !root.classList.contains('is-manual')) {
          root.classList.add('is-cycling');
          timer = window.setInterval(() => set(root.dataset.mode === 'day' ? 'night' : 'day'), 5500);
        } else if (!e.isIntersecting && timer) { clearInterval(timer); timer = undefined; root.classList.remove('is-cycling'); }
      }, { threshold: 0.35 });
      io.observe(root);
    }
  });
</script>

<style>
  .flow { overflow: hidden; background: radial-gradient(90% 70% at 85% 30%, #1e4232 0%, var(--spruce) 55%); transition: background .8s var(--ease); }
  .flow[data-mode='night'] { background: radial-gradient(90% 70% at 85% 30%, #1a2b3f 0%, #0c1622 60%); }
  .flow__grid { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) { .flow__grid { grid-template-columns: 0.85fr 1.15fr; gap: 72px; } }
  .flow__copy :global(.s-head) { margin-bottom: 36px; }
  .flow__seg { position: relative; display: inline-flex; gap: 4px; padding: 4px; border-radius: 12px; background: rgba(255,255,255,.07); box-shadow: inset 0 0 0 1px var(--line-inv); overflow: hidden; }
  .flow__seg button { display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border: 0; border-radius: 9px; background: transparent; color: rgba(238,241,236,.7); font-weight: 600; transition: background .3s, color .3s; }
  .flow__seg button[aria-checked='true'] { background: #fff; color: var(--ink); }
  .flow__progress { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; }
  .flow__progress span { display: block; height: 100%; width: 0; background: var(--volt); }
  :global(.flow.is-cycling:not(.is-manual)) .flow__progress span { animation: prog 5.5s linear infinite; }
  @keyframes prog { to { width: 100%; } }
  .flow__steps { list-style: none; display: grid; gap: 0; margin-top: 28px; counter-reset: s; border-top: 1px solid var(--line-inv); }
  .flow__steps li { display: flex; gap: 16px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--line-inv); font-size: 1.0625rem; color: #fff; }
  .flow__steps li span { font-size: .75rem; color: var(--volt); letter-spacing: .08em; }
  .flow[data-mode='day'] .flow__steps[data-variant='night'], .flow[data-mode='night'] .flow__steps[data-variant='day'] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .flow__steps li { animation: stepIn .6s var(--ease) both; }
    .flow__steps li:nth-child(2) { animation-delay: .08s; } .flow__steps li:nth-child(3) { animation-delay: .16s; } .flow__steps li:nth-child(4) { animation-delay: .24s; }
    @keyframes stepIn { from { opacity: 0; transform: translateX(-8px); } }
  }

  .flow__fig { margin: 0; border-radius: 18px; background: rgba(255,255,255,.035); box-shadow: inset 0 0 0 1px var(--line-inv); padding: clamp(8px, 2vw, 24px); }
  .flow__svg { width: 100%; height: auto; overflow: visible; }
  .guides path { stroke: rgba(255,255,255,.12); stroke-width: 1.5; fill: none; stroke-dasharray: 2 6; }
  .flow-line { fill: none; stroke: var(--volt); stroke-width: 2; stroke-linecap: round; opacity: .55; }
  .flow-line--standby { stroke: rgba(255,255,255,.3); stroke-dasharray: 3 7; opacity: 1; }
  .dot { fill: var(--volt); filter: drop-shadow(0 0 6px rgba(200,238,98,.8)); }
  .flows { transition: opacity .7s var(--ease); }
  .flow[data-mode='day'] .flows--night, .flow[data-mode='night'] .flows--day { opacity: 0; }
  .node__disc { fill: rgba(255,255,255,.05); stroke: rgba(255,255,255,.22); stroke-width: 1.2; transition: fill .6s, stroke .6s; }
  .node__disc--home { fill: rgba(255,255,255,.09); }
  .node__icon, .sun-icon { fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .node__label { fill: rgba(238,241,236,.8); font-family: var(--font-body); font-size: 15px; font-weight: 500; text-anchor: middle; }
  @media (max-width: 719px) { .node__label { font-size: 21px; } }
  .win { fill: #f7d58a; stroke: none; opacity: 0; transition: opacity .6s; }
  .flow[data-mode='night'] .win { opacity: 1; }
  .sun-icon { stroke: #f7d58a; transition: opacity .6s; }
  .moon-icon { fill: none; stroke: #cfd8ea; stroke-width: 2; opacity: 0; transition: opacity .6s; }
  .flow[data-mode='night'] .sun-icon, .flow[data-mode='night'] .sun-glow { opacity: 0; }
  .flow[data-mode='night'] .moon-icon { opacity: 1; }
  .sun-glow { transition: opacity .6s; }
  .flow[data-mode='night'] .node--panels { opacity: .38; }
  .node--panels { transition: opacity .6s; }
  .charge { fill: var(--volt); transform-origin: 0 15px; transform-box: fill-box; opacity: .85; }
  @media (prefers-reduced-motion: no-preference) {
    .flow[data-mode='day'] .charge { animation: charge 5.5s var(--ease) both; }
    .flow[data-mode='night'] .charge { animation: discharge 5.5s var(--ease) both; }
    @keyframes charge { from { transform: scaleY(.25); } to { transform: scaleY(1); } }
    @keyframes discharge { from { transform: scaleY(1); } to { transform: scaleY(.3); } }
    .flow[data-mode='day'] .flows--day .flow-line { stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 1s var(--ease) forwards; animation-delay: var(--delay, 0s); }
    @keyframes draw { to { stroke-dashoffset: 0; } }
  }
  .flow[data-mode='day'] .node--home .node__disc--home, .flow[data-mode='night'] .node--home .node__disc--home { stroke: var(--volt); }
</style>
