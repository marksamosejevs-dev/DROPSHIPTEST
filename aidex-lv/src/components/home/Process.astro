---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { useT, path, type Locale } from '../../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const p = t.process;
---
<section class="section proc" aria-labelledby="proc-title">
  <div class="container">
    <SectionHead eyebrow={p.eyebrow} title={p.title} id="proc-title" />
    <ol class="proc__list">
      {p.steps.map((s, i) => (
        <li class:list={['proc__step', i === p.steps.length - 1 && 'proc__step--last']} data-reveal style={`--d:${i * 0.06}s`}>
          <span class="proc__num tnum" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="proc__cta" data-reveal>
      <a href={path('offer', lang)} class="btn btn--primary">{t.cta.offer}<Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .proc { background: var(--bg); }
  .proc__list { list-style: none; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0 24px; position: relative; }
  .proc__list::before { content: ''; position: absolute; left: 0; right: 0; top: 21px; height: 2px; background: linear-gradient(90deg, var(--line-strong) 0 calc(100% - 16.6%), var(--brand) calc(100% - 16.6%)); }
  .proc__step { position: relative; display: grid; gap: 8px; align-content: start; }
  .proc__num { position: relative; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 2px var(--line-strong); font-family: var(--font-display); font-weight: 800; font-size: 1.05rem; color: var(--ink); margin-bottom: 14px; }
  .proc__step--last .proc__num { background: var(--brand); color: #fff; box-shadow: 0 0 0 6px var(--brand-50); }
  .proc__step h3 { font-size: 1.2rem; }
  .proc__step p { color: var(--muted); font-size: .9688rem; }
  .proc__cta { display: flex; justify-content: center; margin-top: 56px; }
  @media (max-width: 1099px) {
    .proc__list { grid-template-columns: 1fr; gap: 0; max-width: 560px; margin-inline: auto; }
    .proc__list::before { left: 21px; right: auto; top: 22px; bottom: 22px; width: 2px; height: auto; background: var(--line-strong); }
    .proc__step { grid-template-columns: 44px 1fr; column-gap: 20px; padding-bottom: 28px; }
    .proc__step:last-child { padding-bottom: 0; }
    .proc__num { grid-row: span 2; margin: 0; }
    .proc__step h3 { align-self: center; padding-top: 10px; }
    .proc__cta { margin-top: 40px; }
  }
</style>
