---
import LeadForm from '../LeadForm.astro';
import Icon from '../Icon.astro';
import PriceDisclaimer from '../PriceDisclaimer.astro';
import { useT, type Locale } from '../../i18n';
interface Props { lang: Locale; source?: string }
const { lang, source = 'final-cta' } = Astro.props;
const t = useT(lang);
const f = t.final;
const v = t.v2.final;
---
<section class="section fcta" id="offer" aria-labelledby="fcta-title" data-hide-mobile-cta>
  <div class="container">
    <div class="fcta__card">
      <div class="fcta__copy" data-reveal>
        <h2 id="fcta-title">{v.title}</h2>
        <p class="lead">{v.lead}</p>
        <ul class="fcta__points">{f.points.map((p) => <li><Icon name="check" size={18} />{p}</li>)}</ul>
        <PriceDisclaimer lang={lang} />
      </div>
      <div class="fcta__form" data-reveal style="--d:.1s">
        <LeadForm lang={lang} id={`lead-${source}`} source={source} />
      </div>
    </div>
  </div>
</section>

<style>
  .fcta { background: var(--bg); }
  .fcta__card { position: relative; isolation: isolate; overflow: hidden; display: grid; gap: 40px; align-items: center; padding: clamp(28px, 5vw, 72px); border-radius: var(--r-xl); background: radial-gradient(70% 90% at 100% 0%, #1d5242 0%, var(--deep) 58%); color: rgba(236,243,240,.84); box-shadow: var(--shadow-card); }
  .fcta__card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: repeating-linear-gradient(120deg, rgba(255,255,255,.03) 0 2px, transparent 2px 140px); }
  @media (min-width: 1000px) { .fcta__card { grid-template-columns: 1fr minmax(420px, 500px); gap: 72px; } }
  .fcta__copy { display: grid; gap: 22px; }
  .fcta__copy h2 { font-size: clamp(2rem, 4.2vw, 3.4rem); color: #fff; }
  .fcta__copy .lead { color: rgba(236,243,240,.78); max-width: 46ch; }
  .fcta__points { list-style: none; display: grid; gap: 12px; }
  .fcta__points li { display: flex; gap: 12px; align-items: center; color: #fff; font-weight: 500; }
  .fcta__points :global(svg) { color: #7fd6a8; }
  .fcta :global(.disclaimer) { color: rgba(236,243,240,.6); }
  @media (max-width: 719px) { .fcta__card { border-radius: var(--r-lg); padding: 24px 16px 16px; } .fcta__copy { padding: 0 6px; } }
</style>
