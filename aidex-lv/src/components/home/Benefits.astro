---
import SectionHead from '../SectionHead.astro';
import Picture from '../Picture.astro';
import { useT, fmtEur, fmtNum, units, type Locale } from '../../i18n';
import { calculate } from '../../lib/calc';
import { calculatorAssumptions as A } from '../../data/calculator';
import { media } from '../../data/media';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const b = t.benefits;
const u = units[lang];
const r = calculate({ mode: 'kwh', value: A.defaultConsumption, battery: true, support: true });
const stats = [
  { value: Math.round(r.savings / 10) * 10, text: fmtEur(Math.round(r.savings / 10) * 10, lang), label: b.labels.savings },
  { value: Math.round(r.productionKwh / 100) * 100, text: `${fmtNum(Math.round(r.productionKwh / 100) * 100, lang)}`, suffix: ` ${u.kwh}`, label: b.labels.production },
  { value: Math.round(A.selfUseWithBattery * 100), text: `${Math.round(A.selfUseWithBattery * 100)}`, suffix: ' %', label: b.labels.selfUse },
  { value: 0, text: r.paybackYears ? `~${fmtNum(Math.round(r.paybackYears), lang)}` : '—', suffix: ` ${t.calc.results.years}`, label: b.labels.payback },
];
---
<section class="section section--white ben" aria-labelledby="ben-title">
  <div class="container">
    <SectionHead eyebrow={b.eyebrow} title={b.title} id="ben-title" />
    <div class="ben__ex" data-reveal>
      <div class="ben__exhead">
        <p class="ben__exlabel">{b.example.replace('{kwh}', fmtNum(A.defaultConsumption, lang))}</p>
        <p class="ben__exnote">{b.exampleNote}</p>
      </div>
      <dl class="ben__stats">
        {stats.map((s) => (
          <div>
            <dd class="tnum"><span data-count={s.value || undefined}>{s.text}</span>{s.suffix && <small>{s.suffix}</small>}</dd>
            <dt>{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
    <div class="ben__grid">
      <figure class="ben__img media media--zoom" data-reveal>
        <Picture src={media.homeDay.src} alt={media.homeDay.alt[lang]} sizes="(min-width: 1000px) 45vw, 100vw" widths={[600, 900, 1300, 1800]} />
      </figure>
      <ul class="ben__list">
        {b.items.map((it, i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <span class="ben__n tnum">{String(i + 1).padStart(2, '0')}</span>
            <div><h3>{it.title}</h3><p>{it.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .ben__ex { border-radius: 16px; background: var(--paper); padding: clamp(22px, 3vw, 40px); display: grid; gap: 28px; margin-bottom: clamp(40px, 5vw, 72px); }
  .ben__exhead { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; align-items: baseline; }
  .ben__exlabel { font-weight: 600; }
  .ben__exnote { font-size: .8125rem; color: var(--muted); }
  .ben__stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 20px; margin: 0; }
  @media (min-width: 900px) { .ben__stats { grid-template-columns: repeat(4, 1fr); } .ben__stats div + div { border-left: 1px solid var(--line); padding-left: 28px; } }
  .ben__stats div { display: flex; flex-direction: column-reverse; gap: 8px; justify-content: flex-end; }
  .ben__stats dd { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(2.2rem, 4.2vw, 3.6rem); letter-spacing: -0.045em; line-height: 1; }
  .ben__stats small { font-size: .42em; letter-spacing: 0; font-weight: 500; color: var(--muted); }
  .ben__stats dt { font-size: .875rem; color: var(--muted); }
  .ben__grid { display: grid; gap: clamp(32px, 4vw, 64px); align-items: center; }
  @media (min-width: 1000px) { .ben__grid { grid-template-columns: 1fr 1fr; } }
  .ben__img { margin: 0; aspect-ratio: 16 / 11; }
  .ben__list { list-style: none; display: grid; }
  .ben__list li { display: flex; gap: 20px; padding: 24px 0; border-top: 1px solid var(--line); }
  .ben__list li:last-child { border-bottom: 1px solid var(--line); }
  .ben__n { font-size: .75rem; color: var(--moss); font-weight: 600; letter-spacing: .08em; padding-top: 6px; }
  .ben__list h3 { font-size: 1.35rem; letter-spacing: -0.02em; margin-bottom: 6px; }
  .ben__list p { color: var(--muted); }
</style>
