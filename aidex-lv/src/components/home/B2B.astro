---
/**
 * Progression HOME → BUSINESS → AIDEX ENERGY GROUP. Group facts come from
 * src/config/company.ts (group.facts) and must be confirmed before launch.
 */
import SectionHead from '../SectionHead.astro';
import Picture from '../Picture.astro';
import Icon from '../Icon.astro';
import { useT, path, type Locale } from '../../i18n';
import { group } from '../../config/company';
import { media } from '../../data/media';
interface Props { lang: Locale; headingLevel?: 1 | 2; compact?: boolean }
const { lang, headingLevel = 2, compact = false } = Astro.props;
const t = useT(lang);
const b = t.b2b;
const v = t.v2.b2b;
const imgs = [media.pkg8, media.commercialRoof, media.solarField];
const links = [
  { href: path('packages', lang), label: t.cta.allPackages, ext: false },
  { href: path('business', lang), label: compact ? t.cta.businessMore : t.cta.b2b, ext: false },
  { href: group.url, label: t.cta.group, ext: true },
];
const catIcons = ['warehouse', 'factory', 'battery', 'truck'];
const catIds = ['commercial', 'industrial', 'bess', 'supply'];
---
<section class="section b2b" id="business" aria-labelledby="b2b-title">
  <div class="b2b__bg" aria-hidden="true"></div>
  <div class="container">
    <SectionHead eyebrow={v.eyebrow} title={v.title} lead={v.lead} id="b2b-title" level={headingLevel} />

    <ol class="b2b__stages">
      {v.stages.map((s, i) => (
        <li class:list={['st', i === 2 && 'st--group']} data-reveal style={`--d:${i * 0.1}s`}>
          <figure class="st__media"><Picture src={imgs[i].src} alt={imgs[i].alt[lang]} sizes="(min-width: 1000px) 30vw, 100vw" widths={[480, 720, 960]} /></figure>
          <div class="st__body">
            <p class="st__tag">{s.tag}</p>
            <h3>{s.title}</h3>
            <ul>{s.points.map((p) => <li><Icon name="check" size={16} />{p}</li>)}</ul>
            {i === 2 && (
              <p class="st__stat"><strong class="tnum">{group.facts.biomassTonnes}</strong><span>{b.groupStat}</span></p>
            )}
            <a href={links[i].href} class:list={['btn btn--sm', i === 2 ? 'btn--white' : 'btn--ghost-inv']} {...(links[i].ext ? { target: '_blank', rel: 'noopener' } : {})}>
              {links[i].label}<Icon name={links[i].ext ? 'external' : 'arrow'} />
            </a>
          </div>
          {i < 2 && <span class="st__arrow" aria-hidden="true"><Icon name="arrow" size={20} /></span>}
        </li>
      ))}
    </ol>

    {!compact && (
      <ul class="b2b__cats">
        {b.categories.map((c, i) => (
          <li id={catIds[i]} data-reveal style={`--d:${i * 0.06}s`}>
            <span class="b2b__ci"><Icon name={catIcons[i]} size={22} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .b2b { position: relative; background: var(--deep); color: rgba(236,243,240,.84); overflow: hidden; isolation: isolate; }
  .b2b__bg { position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 50% at 85% 0%, rgba(52,199,123,.18), transparent 70%), radial-gradient(50% 40% at 0% 100%, rgba(124,200,255,.1), transparent 70%), repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 120px); }
  .b2b :global(.s-head h2) { color: #fff; }
  .b2b :global(.lead) { color: rgba(236,243,240,.82) !important; }
  .b2b :global(.eyebrow) { color: #7fd6a8; }
  .b2b__stages { list-style: none; display: grid; gap: 20px; grid-template-columns: 1fr; }
  @media (min-width: 1000px) { .b2b__stages { grid-template-columns: repeat(3, 1fr); gap: 28px; } }
  .st { position: relative; display: grid; grid-template-rows: auto 1fr; border-radius: var(--r-lg); background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1px var(--line-inv); overflow: visible; }
  .st--group { background: linear-gradient(160deg, rgba(52,199,123,.22), rgba(52,199,123,.04)); box-shadow: inset 0 0 0 1px rgba(127,214,168,.4); }
  @media (min-width: 600px) and (max-width: 999px) { .st__media { aspect-ratio: 21 / 9 !important; } }
  .st__media { margin: 0; aspect-ratio: 16 / 10; border-radius: var(--r-lg) var(--r-lg) 0 0; overflow: hidden; }
  .st__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .st__body { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 24px 26px 28px; }
  .st__body > .btn { margin-top: auto; }
  .st ul { flex: none; }
  .st__tag { font-size: .8125rem; font-weight: 700; letter-spacing: .04em; color: #7fd6a8; }
  .st h3 { font-size: 1.45rem; color: #fff; }
  .st ul { list-style: none; display: grid; gap: 8px; margin-bottom: 6px; }
  .st li { display: flex; gap: 10px; align-items: flex-start; font-size: .9688rem; }
  .st li :global(svg) { color: #7fd6a8; flex: none; margin-top: 4px; }
  .st__stat { display: grid; gap: 2px; padding: 14px 0; border-top: 1px solid var(--line-inv); width: 100%; }
  .st__stat strong { font-family: var(--font-display); font-weight: 800; font-size: 2rem; letter-spacing: -0.03em; color: #fff; }
  .st__stat span { font-size: .8438rem; color: rgba(236,243,240,.7); }
  .st__arrow { position: absolute; z-index: 2; right: -24px; top: calc(50% - 20px); width: 40px; height: 40px; display: none; place-items: center; border-radius: 50%; background: var(--brand); color: #fff; box-shadow: 0 0 0 6px var(--deep); }
  @media (min-width: 1000px) { .st__arrow { display: grid; right: -34px; } }
  .b2b__cats { list-style: none; display: grid; gap: 16px; grid-template-columns: 1fr; margin-top: 48px; }
  @media (min-width: 720px) { .b2b__cats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .b2b__cats { grid-template-columns: repeat(4, 1fr); } }
  .b2b__cats li { padding: 24px; border-radius: var(--r-md); background: rgba(255,255,255,.04); box-shadow: inset 0 0 0 1px var(--line-inv); display: grid; gap: 10px; align-content: start; scroll-margin-top: calc(var(--header-h) + 24px); }
  .b2b__ci { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; background: rgba(127,214,168,.12); color: #7fd6a8; }
  .b2b__cats h3 { font-size: 1.2rem; color: #fff; }
  .b2b__cats p { font-size: .9375rem; color: rgba(236,243,240,.68); }
</style>
