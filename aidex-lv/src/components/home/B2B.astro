---
import SectionHead from '../SectionHead.astro';
import Picture from '../Picture.astro';
import Icon from '../Icon.astro';
import { useT, path, type Locale } from '../../i18n';
import { group } from '../../config/company';
import { media } from '../../data/media';
interface Props { lang: Locale; headingLevel?: 1 | 2; compact?: boolean }
const { lang, headingLevel = 2, compact = false } = Astro.props;
const t = useT(lang);
const b = t.b2b;
const catIcons = ['warehouse', 'factory', 'battery', 'truck'];
const catIds = ['commercial', 'industrial', 'bess', 'supply'];
const segIcons = ['warehouse', 'factory', 'office', 'store', 'truck', 'leaf'];
---
<section class="section dark b2b" id="business" aria-labelledby="b2b-title">
  <div class="container">
    <SectionHead eyebrow={b.eyebrow} title={b.title} lead={b.lead} split id="b2b-title" level={headingLevel}>
      <div class="b2b__ctas">
        <a href={compact ? path('business', lang) : path('contact', lang)} class="btn btn--volt">{compact ? t.cta.more : t.cta.b2b}<Icon name="arrow" /></a>
        <a href={group.url} class="btn btn--ghost-inv" rel="noopener" target="_blank">{t.cta.group}<Icon name="external" /></a>
      </div>
    </SectionHead>

    <div class="b2b__hero" data-reveal>
      <figure class="media b2b__media">
        <Picture src={media.commercialRoof.src} alt={media.commercialRoof.alt[lang]} sizes="100vw" widths={[800, 1200, 1600, 2000]} />
      </figure>
      <ul class="b2b__segs" aria-label={b.segmentsTitle}>
        {b.segments.map((s, i) => <li><Icon name={segIcons[i]} size={18} />{s}</li>)}
      </ul>
    </div>

    <ul class="b2b__cats">
      {b.categories.map((c, i) => (
        <li id={catIds[i]} data-reveal style={`--d:${i * 0.06}s`}>
          <span class="b2b__ci"><Icon name={catIcons[i]} size={22} /></span>
          <h3>{c.title}</h3>
          <p>{c.text}</p>
        </li>
      ))}
    </ul>

    <div class="b2b__split" data-reveal>
      <div class="b2b__side">
        <p class="b2b__brand">{b.split.local}</p>
        <p>{b.split.localText}</p>
      </div>
      <div class="b2b__link" aria-hidden="true"><span></span><Icon name="arrow" /><span></span></div>
      <div class="b2b__side b2b__side--intl">
        <p class="b2b__brand">{b.split.intl}</p>
        <p>{b.split.intlText}</p>
      </div>
    </div>

    <div class="b2b__group" data-reveal>
      <figure class="media b2b__gimg">
        <Picture src={media.solarField.src} alt={media.solarField.alt[lang]} sizes="(min-width: 1000px) 50vw, 100vw" widths={[600, 900, 1300, 1800]} />
      </figure>
      <div class="b2b__gcopy">
        <p class="eyebrow">{b.groupEyebrow}</p>
        <h3>{b.groupTitle}</h3>
        <p class="b2b__gtext">{b.groupText}</p>
        <div class="b2b__stat">
          <p class="b2b__statv tnum">{group.facts.biomassTonnes}</p>
          <p class="b2b__statl">{b.groupStat}</p>
          <p class="b2b__src">{b.groupStatSource}{!group.facts.biomassTonnesConfirmed && <span class="dev-flag">{t.tbc}</span>}</p>
        </div>
        <a href={group.url} class="btn btn--ghost-inv" rel="noopener" target="_blank">{t.cta.group}<Icon name="external" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .b2b { background: var(--ink); overflow: hidden; }
  .b2b__ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .b2b__hero { position: relative; margin-bottom: 16px; }
  .b2b__media { aspect-ratio: 21 / 9; margin: 0; }
  @media (max-width: 719px) { .b2b__media { aspect-ratio: 4 / 3; } }
  .b2b__segs { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  @media (min-width: 900px) { .b2b__segs { position: absolute; left: 24px; bottom: 24px; right: 24px; margin: 0; } }
  .b2b__segs li { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 999px; background: rgba(11,20,16,.66); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px var(--line-inv); font-size: .875rem; font-weight: 500; color: #fff; }
  .b2b__segs :global(svg) { color: var(--volt); }
  .b2b__cats { list-style: none; display: grid; gap: 0; grid-template-columns: 1fr; border-top: 1px solid var(--line-inv); margin-top: 40px; }
  @media (min-width: 720px) { .b2b__cats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .b2b__cats { grid-template-columns: repeat(4, 1fr); } }
  .b2b__cats li { padding: 32px 28px 36px 0; display: grid; gap: 12px; align-content: start; border-bottom: 1px solid var(--line-inv); scroll-margin-top: calc(var(--header-h) + 24px); }
  @media (min-width: 1100px) { .b2b__cats li + li { padding-left: 28px; border-left: 1px solid var(--line-inv); } .b2b__cats li { border-bottom: 0; } }
  .b2b__ci { width: 48px; height: 48px; border-radius: 12px; display: grid; place-items: center; background: rgba(200,238,98,.1); color: var(--volt); margin-bottom: 6px; }
  .b2b__cats h3 { font-size: 1.3rem; letter-spacing: -0.02em; color: #fff; }
  .b2b__cats p { color: rgba(238,241,236,.64); font-size: .9375rem; }

  .b2b__split { display: grid; grid-template-columns: 1fr; gap: 12px; margin: clamp(56px, 7vw, 96px) 0 16px; align-items: stretch; }
  @media (min-width: 900px) { .b2b__split { grid-template-columns: 1fr auto 1fr; gap: 0; } }
  .b2b__side { padding: 28px; border-radius: 14px; box-shadow: inset 0 0 0 1px var(--line-inv); display: grid; gap: 6px; }
  .b2b__side p:not(.b2b__brand) { color: rgba(238,241,236,.66); }
  .b2b__side--intl { background: linear-gradient(135deg, rgba(200,238,98,.14), rgba(200,238,98,.02)); box-shadow: inset 0 0 0 1px rgba(200,238,98,.3); }
  .b2b__brand { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; color: #fff; }
  .b2b__link { display: none; align-items: center; gap: 8px; padding: 0 16px; color: var(--volt); }
  .b2b__link span { width: 32px; height: 1px; background: var(--line-inv); }
  @media (min-width: 900px) { .b2b__link { display: flex; } }

  .b2b__group { display: grid; gap: 0; border-radius: 16px; overflow: hidden; background: var(--spruce); box-shadow: inset 0 0 0 1px var(--line-inv); }
  @media (min-width: 1000px) { .b2b__group { grid-template-columns: 1fr 1fr; } }
  .b2b__gimg { margin: 0; border-radius: 0; aspect-ratio: 16 / 10; }
  @media (min-width: 1000px) { .b2b__gimg { aspect-ratio: auto; height: 100%; } }
  .b2b__gcopy { padding: clamp(28px, 4vw, 56px); display: grid; gap: 18px; align-content: center; justify-items: start; }
  .b2b__gcopy h3 { font-size: clamp(1.7rem, 3vw, 2.4rem); color: #fff; }
  .b2b__gtext { color: rgba(238,241,236,.72); }
  .b2b__stat { display: grid; gap: 4px; padding: 20px 0; border-top: 1px solid var(--line-inv); border-bottom: 1px solid var(--line-inv); width: 100%; }
  .b2b__statv { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 3.6rem); font-weight: 600; letter-spacing: -0.045em; color: var(--volt); line-height: 1; }
  .b2b__statl { color: rgba(238,241,236,.8); font-size: .9375rem; }
  .b2b__src { display: flex; gap: 10px; align-items: center; font-size: .75rem; color: rgba(238,241,236,.46); }
</style>
