---
/**
 * Projects gallery. Renders only published, client-approved projects from
 * src/data/projects.ts (development samples only with PUBLIC_DEV_MARKERS=1).
 * With no real projects the homepage section is omitted; the projects page
 * (`filter`) shows a short, honest empty state instead.
 */
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { useT, path, type Locale } from '../../i18n';
import { visibleProjects } from '../../data/projects';
interface Props { lang: Locale; limit?: number; headingLevel?: 1 | 2; filter?: boolean; exclude?: string }
const { lang, limit, headingLevel = 2, filter = false, exclude } = Astro.props;
const t = useT(lang);
const p = t.projects;
const all = visibleProjects().filter((x) => x.slug !== exclude);
const list = limit ? all.slice(0, limit) : all;
const segments = new Set(list.map((x) => x.segment));
---
{list.length > 0 ? <section class="section section--white prj" aria-labelledby="prj-title" data-projects>
  <div class="container">
    <SectionHead eyebrow={p.eyebrow} title={exclude ? p.detail.more : p.title} lead={exclude ? undefined : p.lead} split id="prj-title" level={headingLevel}>
      {limit && <a href={path('projects', lang)} class="link-arrow">{t.cta.allProjects}<Icon name="arrow" /></a>}
      {filter && segments.size > 1 && (
        <div class="prj__filter" role="group">
          {(['all', 'home', 'business'] as const).map((k, i) => <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={k}>{p.segments[k]}</button>)}
        </div>
      )}
    </SectionHead>
    <ul class="prj__grid">
      {list.map((x, i) => (
        <li class:list={['prj__item', i === 0 && list.length > 2 && !limit && 'prj__item--lead']} data-segment={x.segment} data-reveal style={`--d:${(i % 3) * 0.06}s`}>
          <ProjectCard project={x} lang={lang} lead={i === 0 && list.length > 2 && !limit} />
        </li>
      ))}
    </ul>
  </div>
</section> : filter && (
  <section class="section section--white prj" aria-labelledby="prj-title">
    <div class="container prj__empty">
      <h2 id="prj-title">{p.title}</h2>
      <p class="lead muted">{t.pages.projects.empty}</p>
      <a href={path('offer', lang)} class="btn btn--primary">{t.cta.offer}<Icon name="arrow" /></a>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-projects]').forEach((root) => {
    const btns = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-segment]').forEach((it) => {
        it.hidden = b.dataset.filter !== 'all' && it.dataset.segment !== b.dataset.filter;
      });
    }));
  });
</script>

<style>
  .prj__empty { display: grid; justify-items: center; text-align: center; gap: 18px; max-width: 640px; }
  .prj__empty h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .prj__grid { list-style: none; display: grid; gap: 40px 24px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .prj__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .prj__grid { grid-template-columns: repeat(3, 1fr); } .prj__item--lead { grid-column: span 2; grid-row: span 2; } }
  .prj__filter { display: inline-flex; gap: 4px; padding: 5px; border-radius: 999px; background: var(--bg); box-shadow: inset 0 0 0 1px var(--line); }
  .prj__filter button { border: 0; background: transparent; min-height: 40px; padding: 0 18px; border-radius: 999px; font-weight: 600; font-size: .9375rem; color: var(--muted); cursor: pointer; }
  .prj__filter button[aria-pressed='true'] { background: var(--brand); color: #fff; }
</style>
