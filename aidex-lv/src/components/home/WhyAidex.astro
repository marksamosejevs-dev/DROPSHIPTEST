---
import SectionHead from '../SectionHead.astro';
import Picture from '../Picture.astro';
import { useT, units, type Locale } from '../../i18n';
import { media } from '../../data/media';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const w = t.why;
const v = t.v2.why;
const u = units[lang];
const [one, , , battery] = w.pillars;
---
<section class="section why" aria-labelledby="why-title">
  <div class="container">
    <SectionHead eyebrow={w.eyebrow} title={v.title} lead={w.lead} id="why-title" />

    <ul class="why__cards">
      <li class="wc" data-reveal>
        <figure class="wc__media media"><Picture src={media.pkg10.src} alt={media.pkg10.alt[lang]} sizes="(min-width: 1000px) 30vw, 100vw" widths={[480, 720, 960]} /></figure>
        <h3>{one.title}</h3>
        <p>{one.text}</p>
      </li>
      <li class="wc" data-reveal style="--d:.08s">
        <figure class="wc__media media"><Picture src={media.batteryRoom.src} alt={media.batteryRoom.alt[lang]} sizes="(min-width: 1000px) 30vw, 100vw" widths={[480, 720, 960]} /></figure>
        <h3>{battery.title}</h3>
        <p>{battery.text}</p>
      </li>
      <li class="wc" data-reveal style="--d:.16s">
        <div class="wc__media wc__app" aria-hidden="true">
          <div class="app">
            <div class="app__top"><span>AIDEX</span><span>{v.today}</span></div>
            <p class="app__big tnum">38,4 <small>{u.kwh}</small></p>
            <p class="app__cap">{v.produced}</p>
            <svg class="app__chart" viewBox="0 0 200 60" preserveAspectRatio="none"><path d="M0 58 C30 58 40 50 60 36 S100 4 120 8 S160 40 200 56 L200 60 L0 60 Z" fill="url(#g1)" /><path d="M0 58 C30 58 40 50 60 36 S100 4 120 8 S160 40 200 56" fill="none" stroke="#34c77b" stroke-width="2" /><defs><linearGradient id="g1" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#34c77b" stop-opacity=".45" /><stop offset="1" stop-color="#34c77b" stop-opacity="0" /></linearGradient></defs></svg>
            <div class="app__row">
              <div><span>{v.used}</span><strong class="tnum">21,7 {u.kwh}</strong></div>
              <div><span>{v.stored}</span><strong class="tnum">86 %</strong></div>
            </div>
          </div>
        </div>
        <h3>{v.monitor.title}</h3>
        <p>{v.monitor.text}</p>
      </li>
    </ul>

  </div>
</section>

<style>
  .why { background: var(--bg); }
  .why__cards { list-style: none; display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .why__cards { grid-template-columns: repeat(3, 1fr); gap: 20px; } }
  @media (min-width: 720px) and (max-width: 999px) { .wc h3 { font-size: 1.2rem; } .wc p { font-size: .9375rem; } }
  .wc { display: grid; gap: 12px; align-content: start; }
  .wc__media { margin: 0 0 10px; aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; }
  .wc h3 { font-size: 1.45rem; }
  .wc p { color: var(--muted); }
  .wc__app { display: grid; place-items: center; background: radial-gradient(120% 100% at 80% 0%, #1b4a3b 0%, var(--deep) 60%); padding: 24px; }
  .app { width: min(260px, 86%); background: rgba(255,255,255,.06); border-radius: 22px; padding: 20px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.14), 0 30px 60px -20px rgba(0,0,0,.5); color: #fff; }
  .app__top { display: flex; justify-content: space-between; font-size: .75rem; font-weight: 700; letter-spacing: .08em; opacity: .7; }
  .app__big { font-family: var(--font-display); font-weight: 800; font-size: 2.4rem; letter-spacing: -0.03em; margin-top: 14px; line-height: 1; }
  .app__big small { font-size: .45em; opacity: .7; }
  .app__cap { font-size: .8125rem; opacity: .7; }
  .app__chart { width: 100%; height: 60px; margin: 12px 0; }
  .app__row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .app__row div { background: rgba(255,255,255,.07); border-radius: 12px; padding: 10px 12px; display: grid; gap: 2px; }
  .app__row span { font-size: .6875rem; opacity: .7; }
  .app__row strong { font-size: .9375rem; }
</style>
