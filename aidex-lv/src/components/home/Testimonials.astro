---
/** Reviews. Rendered only when at least one genuine, published review exists. */
import SectionHead from '../SectionHead.astro';
import Picture from '../Picture.astro';
import { useT, fmtDate, localeMeta, type Locale } from '../../i18n';
import { visibleReviews, reviewPhoto, reviewText } from '../../data/testimonials';
import { projects } from '../../data/projects';
import { projectPath } from '../../lib/projects';
interface Props { lang: Locale; limit?: number }
const { lang, limit = 6 } = Astro.props;
const t = useT(lang);
const s = t.testimonials;
const list = visibleReviews().slice(0, limit);
---
{list.length > 0 && <section class="section tst" aria-labelledby="tst-title">
  <div class="container">
    <SectionHead eyebrow={s.eyebrow} title={s.title} id="tst-title" />
    <ul class:list={['tst__grid', list.length < 3 && 'tst__grid--few']}>
      {list.map((r, i) => {
        const photo = reviewPhoto(r);
        const pj = r.project ? projects.find((p) => p.slug === r.project && p.published) : null;
        const { text, original } = reviewText(r, lang);
        return (
          <li class="tst__card" data-reveal style={`--d:${i * 0.06}s`}>
            <figure>
              {r.rating !== null && <p class="tst__stars" aria-label={`${r.rating}/5`}>{'★'.repeat(r.rating)}<span aria-hidden="true">{'★'.repeat(5 - r.rating)}</span></p>}
              <blockquote lang={original ?? undefined}><p>{text}</p></blockquote>
              <figcaption>
                {photo ? <Picture src={photo} alt="" class="tst__avatar" widths={[96]} sizes="48px" /> : <span class="tst__avatar" aria-hidden="true">{r.name.slice(0, 1)}</span>}
                <span class="tst__who">
                  <strong>{r.name}</strong>
                  <span>{r.location}{pj ? <> · <a href={projectPath(pj, lang)}>{t.projects.detail.view}</a></> : r.system && ` · ${r.system}`}</span>
                  <span class="tst__src">
                    {r.sourceUrl ? <a href={r.sourceUrl} rel="noopener nofollow" target="_blank">{s.source[r.source]}</a> : s.source[r.source]} · <time datetime={r.date}>{fmtDate(r.date, lang)}</time>
                    {original && <> · {localeMeta[original].name}</>}
                  </span>
                </span>
              </figcaption>
            </figure>
          </li>
        );
      })}
    </ul>
  </div>
</section>}

<style>
  .tst { background: var(--bg); }
  .tst__grid { list-style: none; display: grid; gap: 20px; }
  @media (min-width: 900px) { .tst__grid { grid-template-columns: repeat(3, 1fr); } .tst__grid--few { grid-template-columns: repeat(2, minmax(0, 460px)); justify-content: center; } }
  .tst__card figure { margin: 0; height: 100%; display: grid; gap: 18px; align-content: start; padding: 32px; border-radius: var(--r-lg); background: #fff; box-shadow: var(--shadow-sm); }
  .tst__stars { color: var(--sun); letter-spacing: 3px; font-size: 1.1rem; }
  .tst__stars span { color: var(--line-strong); }
  .tst__card blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.6; color: var(--ink); }
  .tst__card figcaption { display: flex; gap: 12px; align-items: center; margin-top: auto; padding-top: 8px; }
  .tst__avatar, .tst__card figcaption :global(.tst__avatar img) { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  span.tst__avatar { background: var(--brand-50); display: grid; place-items: center; font-weight: 700; color: var(--brand); flex: none; }
  .tst__who { display: grid; gap: 2px; font-size: .8438rem; color: var(--muted); }
  .tst__who strong { color: var(--ink); font-size: .9688rem; }
  .tst__who a { color: var(--brand); }
  .tst__src { font-size: .78rem; }
</style>
