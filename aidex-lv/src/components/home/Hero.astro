---
import Icon from '../Icon.astro';
import { useT, path, fmtEur, type Locale } from '../../i18n';
import { media } from '../../data/media';
import { responsive } from '../../lib/images';
import { packages, netPrice } from '../../data/packages';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
const h = t.v2.hero;
const wide = await responsive(media.hero.src, [960, 1440, 1920, 2400], 72);
const tall = await responsive(media.heroPortrait.src, [540, 810, 1080], 72);
const fromBattery = Math.min(...packages.map((p) => p.withBattery).filter(Boolean).map((p) => netPrice(p!)));
const trustIcons = ['layers', 'battery', 'doc', 'globe'];
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media">
    <picture>
      <source media="(max-width: 719px)" type="image/avif" srcset={tall.avif} sizes="100vw" />
      <source media="(max-width: 719px)" type="image/webp" srcset={tall.webp} sizes="100vw" />
      <source type="image/avif" srcset={wide.avif} sizes="100vw" />
      <source type="image/webp" srcset={wide.webp} sizes="100vw" />
      <img src={wide.fallback} alt={media.hero.alt[lang]} width={wide.width} height={wide.height} fetchpriority="high" decoding="async" />
    </picture>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="hero__content container">
    <p class="hero__chip hero__in" style="--d:.05s"><span aria-hidden="true"></span>{h.chip}</p>
    <h1 id="hero-title" class="hero__title hero__in" style="--d:.12s">{h.title}</h1>
    <p class="hero__lead hero__in" style="--d:.22s">{h.lead}</p>
    <div class="hero__ctas hero__in" style="--d:.32s">
      <a href={path('offer', lang)} class="btn btn--primary" data-cta="hero-offer">{t.cta.offer}<Icon name="arrow" /></a>
      <a href={path('home', lang, 'calculator')} class="btn btn--ghost-inv" data-cta="hero-calc"><Icon name="chart" />{t.cta.calc}</a>
    </div>
    <p class="hero__price hero__in" style="--d:.42s">{h.priceLine.replace('{price}', fmtEur(fromBattery, lang))}</p>
    <a href={path('home', lang, 'packages')} class="hero__down hero__in" style="--d:.5s">{h.seePrices}<Icon name="chevron" size={18} /></a>
  </div>
</section>

<div class="trust container" aria-label={h.facts.join(' · ')}>
  <ul class="trust__card">
    {t.hero.trust.map((item, i) => (
      <li>
        <span class="trust__icon"><Icon name={trustIcons[i]} size={22} /></span>
        <div><strong>{item.title}</strong><span>{item.text}</span></div>
      </li>
    ))}
  </ul>
</div>

<style>
  .hero { position: relative; min-height: max(640px, min(100svh, 940px)); display: grid; align-items: center; overflow: hidden; background: #0c1512; isolation: isolate; color: #fff; }
  .hero__media, .hero__shade { position: absolute; inset: 0; z-index: -1; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 60% 62%; }
  .hero__shade { background: radial-gradient(56% 46% at 50% 44%, rgba(6, 14, 12, 0.5) 0%, rgba(6, 14, 12, 0.18) 72%, rgba(6, 14, 12, 0) 100%), linear-gradient(180deg, rgba(6, 14, 12, 0.4) 0%, rgba(6, 14, 12, 0) 26%, rgba(6, 14, 12, 0) 66%, rgba(6, 14, 12, 0.5) 100%); }
  @media (prefers-reduced-motion: no-preference) {
    .hero__media img { animation: heroZoom 3s var(--ease) both; }
    @keyframes heroZoom { from { transform: scale(1.06); } }
    .hero__in { animation: heroIn 1s var(--ease) both; animation-delay: var(--d, 0s); }
    @keyframes heroIn { from { opacity: 0; transform: translateY(18px); } }
  }
  .hero__content { display: grid; justify-items: center; text-align: center; gap: 22px; padding-top: calc(var(--hdr-total) + 40px); padding-bottom: 120px; }
  .hero__chip { display: inline-flex; align-items: center; gap: 10px; height: 38px; padding: 0 16px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); font-size: .875rem; font-weight: 600; }
  .hero__chip span { width: 8px; height: 8px; border-radius: 50%; background: var(--sun); box-shadow: 0 0 12px var(--sun); }
  .hero__title { color: #fff; font-size: clamp(2.6rem, 6.2vw, 5.4rem); font-weight: 800; letter-spacing: -0.035em; line-height: 1.02; max-width: 14ch; text-shadow: 0 2px 30px rgba(0, 0, 0, 0.25); }
  .hero__lead { font-size: clamp(1.08rem, 1.5vw, 1.3rem); line-height: 1.55; color: rgba(255, 255, 255, 0.9); max-width: 56ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }
  .hero__ctas .btn { min-height: 60px; padding-inline: 30px; font-size: 1.125rem; }
  .hero__price { font-size: .9688rem; font-weight: 600; color: rgba(255, 255, 255, 0.92); }
  .hero__down { display: inline-flex; align-items: center; gap: 6px; color: #fff; font-weight: 600; font-size: .9375rem; text-decoration: underline; text-underline-offset: 6px; opacity: .85; }
  .hero__down:hover { opacity: 1; }

  .trust { position: relative; z-index: 2; margin-top: -64px; }
  .trust__card { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; border-radius: var(--r-lg); box-shadow: var(--shadow-card); padding: 8px; }
  .trust__card li { display: flex; gap: 14px; align-items: center; padding: 20px 22px; }
  .trust__card li + li { border-left: 1px solid var(--line); }
  .trust__icon { width: 46px; height: 46px; flex: none; display: grid; place-items: center; border-radius: 12px; background: var(--brand-50); color: var(--brand); }
  .trust__card div { display: grid; gap: 2px; }
  .trust__card strong { font-family: var(--font-display); font-weight: 750; color: var(--ink); font-size: 1rem; line-height: 1.25; }
  .trust__card span { font-size: .8438rem; color: var(--muted); line-height: 1.4; }
  @media (max-width: 1099px) {
    .trust__card { grid-template-columns: repeat(2, 1fr); }
    .trust__card li:nth-child(3) { border-left: 0; }
    .trust__card li:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 719px) {
    .hero { min-height: calc(100svh - 40px); align-items: end; }
    .hero__media img { object-position: 50% 50%; }
    .hero__shade { background: linear-gradient(180deg, rgba(6,14,12,.55) 0%, rgba(6,14,12,.2) 28%, rgba(6,14,12,.35) 50%, rgba(6,14,12,.88) 82%, rgba(6,14,12,.95) 100%); }
    .hero__content { gap: 16px; padding-top: calc(var(--hdr-total) + 20px); padding-bottom: 88px; }
    .hero__chip { font-size: .8125rem; height: 34px; }
    .hero__title { font-size: clamp(2.3rem, 10.5vw, 2.9rem); }
    .hero__lead { font-size: 1.02rem; }
    .hero__ctas { display: grid; width: 100%; }
    .hero__ctas .btn { min-height: 56px; }
    .hero__down { display: none; }
    .trust { margin-top: -52px; }
    .trust__card { padding: 4px; }
    .trust__card li { padding: 14px 12px; gap: 10px; align-items: flex-start; }
    .trust__icon { width: 38px; height: 38px; border-radius: 10px; }
    .trust__card strong { font-size: .9063rem; }
    .trust__card span { display: none; }
  }
</style>
