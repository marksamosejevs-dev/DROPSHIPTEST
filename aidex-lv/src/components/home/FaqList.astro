---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { useT, path, type Locale } from '../../i18n';
import { faq } from '../../data/faq';
interface Props { lang: Locale; limit?: number; headingLevel?: 1 | 2 }
const { lang, limit, headingLevel = 2 } = Astro.props;
const t = useT(lang);
const items = limit ? faq.slice(0, limit) : faq;
---
<section class="section section--white faq" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__side">
      <SectionHead eyebrow={t.faq.eyebrow} title={t.faq.title} lead={t.faq.lead} id="faq-title" level={headingLevel} align="left" />
      <div class="faq__ask" data-reveal>
        <p>{t.faq.more}</p>
        <a href={path('contact', lang)} class="link-arrow">{t.faq.ask}<Icon name="arrow" /></a>
        {limit && <a href={path('faq', lang)} class="link-arrow">{t.cta.allFaq}<Icon name="arrow" /></a>}
      </div>
    </div>
    <div class="faq__list">
      {items.map((it, i) => (
        <details class="faq__item" data-reveal name="faq" open={i === 0}>
          <summary>
            <span>{it.q[lang]}</span>
            <span class="faq__icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="faq__a"><p>{it.a[lang]}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; gap: 40px; }
  @media (min-width: 1000px) { .faq__grid { grid-template-columns: 0.8fr 1.2fr; gap: 80px; align-items: start; } .faq__side { position: sticky; top: calc(var(--header-h) + 32px); } }
  .faq__ask { display: grid; gap: 10px; justify-items: start; margin-top: -24px; }
  .faq__ask p { color: var(--muted); }
  .faq__list { border-top: 1px solid var(--line-strong); }
  .faq__item { border-bottom: 1px solid var(--line-strong); }
  .faq__item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; cursor: pointer; font-family: var(--font-display); font-size: clamp(1.1rem, 1.6vw, 1.3rem); font-weight: 600; letter-spacing: -0.015em; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary:hover { color: var(--moss); }
  .faq__icon { width: 36px; height: 36px; flex: none; border-radius: 50%; display: grid; place-items: center; box-shadow: inset 0 0 0 1px var(--line-strong); transition: transform .4s var(--ease), background .3s, color .3s; }
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--ink); color: #fff; }
  .faq__a { padding: 0 56px 26px 0; color: var(--muted); font-size: 1.02rem; max-width: 70ch; }
  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a { animation: faqIn .45s var(--ease); }
    @keyframes faqIn { from { opacity: 0; transform: translateY(-6px); } }
  }
  @media (max-width: 719px) { .faq__a { padding-right: 0; } }
</style>
