---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';
import { useT, path, fmtEur, fmtNum, units, type Locale } from '../../i18n';
import { calculatorAssumptions as A } from '../../data/calculator';
import { packages } from '../../data/packages';
import { calculate } from '../../lib/calc';

interface Props { lang: Locale; headingLevel?: 1 | 2 }
const { lang, headingLevel = 2 } = Astro.props;
const t = useT(lang);
const c = t.calc;
const u = units[lang];
const r = calculate({ mode: 'kwh', value: A.defaultConsumption, battery: true, support: true });
const pkgNames = Object.fromEntries(packages.map((p) => [p.id, p.name]));
const note = c.note.replace('{yield}', fmtNum(A.specificYield, lang)).replace('{price}', fmtNum(A.electricityPrice, lang, 2));
const i18n = { years: c.results.years, noBattery: c.results.noBattery, kw: u.kw, kwh: u.kwh, kwhMonth: c.kwhMonth, eurMonth: c.eurMonth };
---
<section class="section calc" id="calculator" aria-labelledby="calc-title" data-calc data-pkgs={JSON.stringify(pkgNames)} data-i18n={JSON.stringify(i18n)} data-offer={path('offer', lang)} data-packages-href={path('packages', lang)}>
  <div class="container">
    <SectionHead eyebrow={c.eyebrow} title={c.title} lead={c.lead} split id="calc-title" level={headingLevel} />

    <div class="calc__grid" data-reveal>
      <form class="calc__in" onsubmit="return false" aria-label={c.title}>
        <fieldset class="calc__mode">
          <legend class="sr-only">{c.mode}</legend>
          <label><input type="radio" name="mode" value="kwh" checked /><span>{c.byConsumption}</span></label>
          <label><input type="radio" name="mode" value="bill" /><span>{c.byBill}</span></label>
        </fieldset>

        <div class="calc__field" data-field="kwh">
          <label for="calc-kwh" class="calc__label">{c.consumption}</label>
          <div class="calc__value">
            <input id="calc-kwh" class="calc__num tnum" type="number" inputmode="numeric" min={A.consumptionRange[0]} max={A.consumptionRange[1]} step={A.consumptionRange[2]} value={A.defaultConsumption} data-num="kwh" />
            <span class="calc__unit">{c.kwhMonth}</span>
          </div>
          <input type="range" class="range" min={A.consumptionRange[0]} max={A.consumptionRange[1]} step={A.consumptionRange[2]} value={A.defaultConsumption} data-range="kwh" aria-label={c.consumption} />
          <div class="calc__scale tnum" aria-hidden="true"><span>{fmtNum(A.consumptionRange[0], lang)}</span><span>{fmtNum(A.consumptionRange[1], lang)}</span></div>
        </div>

        <div class="calc__field" data-field="bill" hidden>
          <label for="calc-bill" class="calc__label">{c.bill}</label>
          <div class="calc__value">
            <input id="calc-bill" class="calc__num tnum" type="number" inputmode="numeric" min={A.billRange[0]} max={A.billRange[1]} step={A.billRange[2]} value={A.defaultBill} data-num="bill" />
            <span class="calc__unit">{c.eurMonth}</span>
          </div>
          <input type="range" class="range" min={A.billRange[0]} max={A.billRange[1]} step={A.billRange[2]} value={A.defaultBill} data-range="bill" aria-label={c.bill} />
          <div class="calc__scale tnum" aria-hidden="true"><span>{fmtEur(A.billRange[0], lang)}</span><span>{fmtEur(A.billRange[1], lang)}</span></div>
        </div>

        <div class="calc__toggles">
          <label class="tgl"><input type="checkbox" name="battery" checked /><span class="tgl__ui" aria-hidden="true"></span><span>{c.battery}</span></label>
          <label class="tgl"><input type="checkbox" name="support" checked /><span class="tgl__ui" aria-hidden="true"></span><span>{c.support}</span></label>
        </div>
        <p class="calc__note">{note}</p>
      </form>

      <div class="calc__out dark" aria-live="polite" aria-atomic="false">
        <div class="calc__hero">
          <p class="calc__olabel">{c.results.system}</p>
          <p class="calc__big tnum"><span data-out="kw">{fmtNum(r.kw, lang, 1)}</span><small>{u.kw}</small></p>
          <p class="calc__pkg">{c.results.package}: <a href={path('packages', lang)} data-out="pkg">{r.packageId ? pkgNames[r.packageId] : '—'}</a></p>
        </div>
        <dl class="calc__metrics">
          <div><dt>{c.results.production}</dt><dd class="tnum"><span data-out="production">{fmtNum(Math.round(r.productionKwh / 10) * 10, lang)}</span> <small>{u.kwh}</small></dd></div>
          <div><dt>{c.results.savings}</dt><dd class="tnum" data-out="savings">{fmtEur(r.savings, lang)}</dd></div>
          <div><dt>{c.results.payback}</dt><dd class="tnum"><span data-out="payback">{r.paybackYears ? fmtNum(r.paybackYears, lang, 1) : '—'}</span> <small>{c.results.years}</small></dd></div>
          <div><dt>{c.results.battery}</dt><dd class="tnum" data-out="battery">{r.batteryKwh ? `${fmtNum(r.batteryKwh, lang)} ${u.kwh}` : c.results.noBattery}</dd></div>
        </dl>
        <div class="calc__cost">
          <div>
            <p class="calc__olabel">{c.results.cost}</p>
            <p class="calc__costv tnum"><s data-out="gross" hidden={r.supportAmount === 0}>{fmtEur(r.cost, lang)}</s> <span data-out="net">{fmtEur(r.net, lang)}</span></p>
          </div>
          <a href={`${path('offer', lang)}?kwh=${Math.round(r.monthlyKwh)}`} class="btn btn--volt" data-out="cta" data-cta="calculator">{c.cta}<Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { calculate } from '../../lib/calc';
  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const lang = document.documentElement.lang;
    const loc = lang === 'en' ? 'en-IE' : lang === 'ru' ? 'ru-RU' : 'lv-LV';
    const eur = new Intl.NumberFormat(loc, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const num = (d = 0) => new Intl.NumberFormat(loc, { maximumFractionDigits: d });
    const pk: Record<string, string> = JSON.parse(root.dataset.pkgs!);
    const i18n = JSON.parse(root.dataset.i18n!);
    const form = root.querySelector('form')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;

    const syncRange = (r: HTMLInputElement) => {
      const p = ((+r.value - +r.min) / (+r.max - +r.min)) * 100;
      r.style.setProperty('--p', `${p}%`);
    };

    function mode() { return (form.querySelector<HTMLInputElement>('input[name="mode"]:checked')!.value) as 'kwh' | 'bill'; }

    function update() {
      const m = mode();
      const numInput = root.querySelector<HTMLInputElement>(`[data-num="${m}"]`)!;
      const value = Math.max(0, Number(numInput.value) || 0);
      const battery = form.querySelector<HTMLInputElement>('input[name="battery"]')!.checked;
      const support = form.querySelector<HTMLInputElement>('input[name="support"]')!.checked;
      const r = calculate({ mode: m, value, battery, support });
      out('kw').textContent = num(1).format(r.kw);
      out('production').textContent = num().format(Math.round(r.productionKwh / 10) * 10);
      out('savings').textContent = eur.format(r.savings);
      out('payback').textContent = r.paybackYears ? num(1).format(r.paybackYears) : '—';
      out('battery').textContent = r.batteryKwh ? `${num().format(r.batteryKwh)} ${i18n.kwh}` : i18n.noBattery;
      out('net').textContent = eur.format(r.net);
      out('gross').textContent = eur.format(r.cost);
      out('gross').hidden = r.supportAmount === 0;
      out('pkg').textContent = r.packageId ? pk[r.packageId] : '—';
      (out('cta') as HTMLAnchorElement).href = `${root.dataset.offer}?kwh=${Math.round(r.monthlyKwh)}&battery=${battery ? 1 : 0}`;
      root.querySelectorAll('.calc__out dd, .calc__big, .calc__costv').forEach((el) => {
        el.classList.remove('pulse'); void (el as HTMLElement).offsetWidth; el.classList.add('pulse');
      });
    }

    root.querySelectorAll<HTMLInputElement>('[data-range]').forEach((range) => {
      const key = range.dataset.range!;
      const numEl = root.querySelector<HTMLInputElement>(`[data-num="${key}"]`)!;
      syncRange(range);
      range.addEventListener('input', () => { numEl.value = range.value; syncRange(range); update(); });
      numEl.addEventListener('input', () => { range.value = numEl.value; syncRange(range); update(); });
      numEl.addEventListener('blur', () => {
        const v = Math.min(+numEl.max, Math.max(+numEl.min, Number(numEl.value) || +numEl.min));
        numEl.value = String(v); range.value = String(v); syncRange(range); update();
      });
    });
    form.querySelectorAll<HTMLInputElement>('input[name="mode"]').forEach((r) => r.addEventListener('change', () => {
      const m = mode();
      root.querySelectorAll<HTMLElement>('[data-field]').forEach((f) => (f.hidden = f.dataset.field !== m));
      update();
    }));
    form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]').forEach((c) => c.addEventListener('change', update));
  });
</script>

<style>
  .calc { background: var(--paper); }
  .calc__grid { display: grid; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow-card), 0 0 0 1px var(--line); background: #fff; }
  @media (min-width: 1000px) { .calc__grid { grid-template-columns: 1fr 1fr; } }
  .calc__in { padding: clamp(24px, 4vw, 48px); display: grid; gap: 32px; align-content: start; }
  .calc__mode { display: inline-flex; justify-self: start; border: 0; padding: 4px; margin: 0; background: var(--sand); border-radius: 10px; gap: 4px; }
  .calc__mode label { position: relative; }
  .calc__mode input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .calc__mode span { display: inline-flex; align-items: center; min-height: 42px; padding: 0 18px; border-radius: 7px; font-weight: 600; font-size: .9375rem; color: var(--muted); transition: background .25s, color .25s; }
  .calc__mode input:checked + span { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08), 0 4px 12px -4px rgba(0,0,0,.12); }
  .calc__mode input:focus-visible + span { outline: 2px solid var(--moss); outline-offset: 2px; }
  .calc__field { display: grid; gap: 14px; }
  .calc__label { font-weight: 600; font-size: .9375rem; }
  .calc__value { display: flex; align-items: baseline; gap: 10px; border-bottom: 1px solid var(--line-strong); padding-bottom: 6px; }
  .calc__num { width: 4.2ch; field-sizing: content; min-width: 2ch; max-width: 100%; border: 0; background: transparent; font-family: var(--font-display); font-size: clamp(2.8rem, 5vw, 3.6rem); font-weight: 600; letter-spacing: -0.04em; padding: 0; line-height: 1.05; -moz-appearance: textfield; appearance: textfield; }
  .calc__num::-webkit-inner-spin-button, .calc__num::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .calc__num:focus { outline: none; }
  .calc__value:focus-within { border-color: var(--ink); }
  .calc__unit { color: var(--muted); font-weight: 500; }
  .calc__scale { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted-2); margin-top: -4px; }
  .range { --p: 30%; -webkit-appearance: none; appearance: none; width: 100%; height: 32px; background: transparent; margin: 0; cursor: pointer; }
  .range::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--ink) var(--p), var(--stone) var(--p)); }
  .range::-moz-range-track { height: 4px; border-radius: 4px; background: var(--stone); }
  .range::-moz-range-progress { height: 4px; border-radius: 4px; background: var(--ink); }
  .range::-webkit-slider-thumb { -webkit-appearance: none; width: 26px; height: 26px; margin-top: -11px; border-radius: 50%; background: #fff; border: 1.5px solid var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,.18); transition: transform .2s; }
  .range::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: #fff; border: 1.5px solid var(--ink); box-shadow: 0 2px 8px rgba(0,0,0,.18); }
  .range:active::-webkit-slider-thumb { transform: scale(1.12); }
  .range:focus-visible { outline: none; }
  .range:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 6px rgba(47,106,78,.2); }
  .calc__toggles { display: grid; gap: 14px; }
  .tgl { display: flex; align-items: center; gap: 12px; cursor: pointer; font-size: .9375rem; font-weight: 500; position: relative; }
  .tgl input { position: absolute; opacity: 0; width: 46px; height: 28px; margin: 0; cursor: pointer; }
  .tgl__ui { width: 46px; height: 28px; flex: none; border-radius: 999px; background: var(--stone); position: relative; transition: background .25s; }
  .tgl__ui::after { content: ''; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.25); transition: transform .3s var(--ease); }
  .tgl input:checked + .tgl__ui { background: var(--moss); }
  .tgl input:checked + .tgl__ui::after { transform: translateX(18px); }
  .tgl input:focus-visible + .tgl__ui { outline: 2px solid var(--moss); outline-offset: 3px; }
  .calc__note { font-size: .8125rem; color: var(--muted); line-height: 1.5; border-top: 1px solid var(--line); padding-top: 18px; }

  .calc__out { padding: clamp(24px, 4vw, 48px); display: grid; gap: 28px; align-content: space-between; background: radial-gradient(120% 90% at 100% 0%, #1d3a2d 0%, var(--ink) 60%); }
  .calc__olabel { font-size: .75rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: rgba(238,241,236,.56); }
  .calc__big { font-family: var(--font-display); font-weight: 600; font-size: clamp(4.2rem, 8vw, 6.4rem); letter-spacing: -0.05em; line-height: 1; display: flex; align-items: baseline; gap: 8px; margin: 8px 0 12px; }
  .calc__big small { font-size: .32em; letter-spacing: 0; opacity: .6; font-weight: 500; }
  .calc__pkg { font-size: .9375rem; color: rgba(238,241,236,.7); }
  .calc__pkg a { color: var(--volt); }
  .calc__metrics { display: grid; grid-template-columns: 1fr 1fr; margin: 0; border-top: 1px solid var(--line-inv); }
  .calc__metrics div { padding: 18px 0; border-bottom: 1px solid var(--line-inv); display: grid; gap: 4px; }
  .calc__metrics div:nth-child(odd) { padding-right: 16px; }
  .calc__metrics div:nth-child(even) { padding-left: 16px; border-left: 1px solid var(--line-inv); }
  .calc__metrics dt { font-size: .8125rem; color: rgba(238,241,236,.56); }
  .calc__metrics dd { margin: 0; font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.03em; color: #fff; }
  .calc__metrics small { font-size: .55em; opacity: .6; font-weight: 500; letter-spacing: 0; }
  .calc__cost { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .calc__costv { font-family: var(--font-display); font-size: 2.2rem; font-weight: 600; letter-spacing: -0.035em; color: #fff; margin-top: 4px; }
  .calc__costv s { font-size: .5em; color: rgba(238,241,236,.45); font-weight: 400; letter-spacing: 0; margin-right: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.pulse) { animation: pulse .5s var(--ease); }
    @keyframes pulse { from { opacity: .45; transform: translateY(3px); } }
  }
  @media (max-width: 519px) {
    .calc__cost .btn { width: 100%; }
    .calc__metrics dd { font-size: 1.35rem; }
  }
</style>
