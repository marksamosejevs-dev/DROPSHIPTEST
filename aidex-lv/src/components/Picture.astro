---
/** Responsive AVIF/WebP picture with lazy loading by default. */
import type { ImageMetadata } from 'astro';
import { responsive } from '../lib/images';
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  quality?: number;
}
const { src, alt, sizes = '100vw', widths = [480, 800, 1200, 1600, 2000], eager = false, class: cls, quality } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const set = await responsive(src, usable.length ? usable : [src.width], quality);
---
<picture class={cls}>
  <source type="image/avif" srcset={set.avif} sizes={sizes} />
  <source type="image/webp" srcset={set.webp} sizes={sizes} />
  <img
    src={set.fallback}
    alt={alt}
    width={set.width}
    height={set.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>
