---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { useT, path, locales, localeMeta, type Locale, type RouteKey } from '../i18n';
import { company, group, known } from '../config/company';

interface Props { lang: Locale; route: RouteKey | null; tone?: 'light' | 'dark' }
const { lang, route, tone = 'dark' } = Astro.props;
const t = useT(lang);
const nav: { key: RouteKey; label: string; low?: boolean }[] = [
  { key: 'solar', label: t.nav.solar },
  { key: 'batteries', label: t.nav.batteries },
  { key: 'packages', label: t.nav.packages },
  { key: 'calculator', label: t.nav.calculator, low: true },
  { key: 'support', label: t.nav.support },
  { key: 'about', label: t.nav.about },
];
const menu: { key: RouteKey; label: string }[] = [
  ...nav,
  { key: 'business', label: t.nav.business },
  { key: 'faq', label: t.nav.faq },
  { key: 'contact', label: t.nav.contact },
];
const langHref = (x: Locale) => path(route ?? 'home', x);
const phone = known(company.phone);
const phoneHref = known(company.phoneHref);
---
<header class:list={['hdr', `hdr--${tone}`]} data-header data-tone={tone}>
  <div class="hdr__util">
    <div class="container hdr__utilin">
      <a href={group.url} target="_blank" rel="noopener" class="hdr__group"><span class="hdr__g1">AIDEX.lv</span><span class="hdr__gdot" aria-hidden="true">·</span>{group.name}<Icon name="external" size={13} /></a>
      <ul class="lang" aria-label={t.nav.language}>
        {locales.map((x) => (
          <li><a href={langHref(x)} hreflang={x} lang={x} aria-current={x === lang ? 'true' : undefined} title={localeMeta[x].name}>{localeMeta[x].label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="hdr__inner container">
    <a href={path('home', lang)} class="hdr__logo">
      <Logo sub={t.v2.brandSub} />
    </a>
    <a href={path('business', lang)} class="hdr__pill" aria-current={route === 'business' ? 'page' : undefined}>
      <span class="hdr__dot" aria-hidden="true"></span>{t.v2.businessPill}
    </a>

    <nav class="hdr__nav" aria-label={t.nav.mainNav}>
      <ul>
        {nav.map((n) => (
          <li class:list={[n.low && 'hdr__low']}><a href={path(n.key, lang)} aria-current={route === n.key ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      {phone && phoneHref ? (
        <a href={`tel:${phoneHref}`} class="hdr__icon" aria-label={`${t.v2.call} ${phone}`}><Icon name="phone" size={20} /></a>
      ) : (
        <a href={path('calculator', lang)} class="hdr__icon" aria-label={t.nav.calculator} title={t.nav.calculator}><Icon name="chart" size={20} /></a>
      )}
      <a href={path('offer', lang)} class="btn btn--primary btn--sm hdr__cta" data-cta="header">{t.cta.offer}</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <span class="sr-only">{t.nav.menu}</span>
        <span class="burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mm" role="dialog" aria-modal="true" aria-label={t.nav.menu} hidden data-menu>
  <div class="mm__top container">
    <a href={path('home', lang)}><Logo sub={t.v2.brandSub} /></a>
    <button type="button" class="mm__close" data-menu-close>
      <span class="sr-only">{t.nav.close}</span><Icon name="close" size={24} />
    </button>
  </div>
  <div class="mm__body container">
    <ul class="mm__lang" aria-label={t.nav.language}>
      {locales.map((x) => (
        <li><a href={langHref(x)} hreflang={x} lang={x} aria-current={x === lang ? 'true' : undefined}>{localeMeta[x].label}<span>{localeMeta[x].name}</span></a></li>
      ))}
    </ul>
    <nav aria-label={t.nav.mainNav}>
      <ul class="mm__nav">
        {menu.map((n, i) => (
          <li style={`--i:${i}`}>
            <a href={path(n.key, lang)} aria-current={route === n.key ? 'page' : undefined}>{n.label}<Icon name="arrow" size={18} /></a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="mm__foot container">
    <a href={path('offer', lang)} class="btn btn--primary btn--block">{t.cta.offer}<Icon name="arrow" /></a>
    {phone && phoneHref ? (
      <a href={`tel:${phoneHref}`} class="btn btn--ghost btn--block"><Icon name="phone" />{phone}</a>
    ) : (
      <a href={path('calculator', lang)} class="btn btn--ghost btn--block">{t.cta.calc}</a>
    )}
  </div>
</div>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--hdr-total); display: grid; grid-template-rows: var(--util-h) var(--header-h); color: var(--ink); background: rgba(255, 255, 255, 0.94); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 var(--line); transition: background-color .35s var(--ease), color .35s var(--ease), box-shadow .35s var(--ease), transform .45s var(--ease); }
  .hdr--dark:not(.is-scrolled) { color: #fff; background: linear-gradient(180deg, rgba(6, 16, 13, 0.55), rgba(6, 16, 13, 0)); backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: none; }
  .hdr--dark:not(.is-scrolled) :global(.logo) { color: #fff; }
  :global(.hdr.is-scrolled) { transform: translateY(calc(-1 * var(--util-h))); }
  :global(.hdr.is-hidden) { transform: translateY(-100%); }
  .hdr__util { background: var(--deep); color: rgba(236, 243, 240, 0.8); font-size: .8125rem; }
  .hdr--dark:not(.is-scrolled) .hdr__util { background: rgba(4, 12, 10, 0.55); }
  .hdr__utilin { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .hdr__group { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 500; white-space: nowrap; overflow: hidden; }
  .hdr__gdot { opacity: .5; }
  .hdr__group:hover { color: #fff; }
  .hdr__inner { height: 100%; display: flex; align-items: center; gap: 16px; }
  .hdr__logo { text-decoration: none; flex: none; }
  .hdr__pill { display: none; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 10px; background: var(--bg); font-family: var(--font-display); font-weight: 700; font-size: .9375rem; text-decoration: none; white-space: nowrap; transition: background .25s; }
  .hdr__pill:hover { background: var(--bg-2); }
  .hdr--dark:not(.is-scrolled) .hdr__pill { background: rgba(255, 255, 255, 0.12); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2); }
  .hdr__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--brand); }
  .hdr--dark:not(.is-scrolled) .hdr__dot { background: #6fd39f; }
  .hdr__nav { flex: 1; display: none; justify-content: center; min-width: 0; }
  .hdr__nav ul { display: flex; align-items: center; list-style: none; }
  .hdr__nav li + li::before { content: ''; width: 1px; height: 16px; background: currentColor; opacity: .2; margin: 0 clamp(8px, 0.9vw, 14px); display: inline-block; vertical-align: middle; }
  .hdr__nav li { display: flex; align-items: center; }
  .hdr__nav a { position: relative; font-size: .9688rem; font-weight: 500; text-decoration: none; white-space: nowrap; padding: 8px 0; opacity: .88; transition: opacity .2s; }
  .hdr__nav a:hover, .hdr__nav a[aria-current='page'] { opacity: 1; }
  .hdr__nav a[aria-current='page'] { color: var(--brand); }
  .hdr--dark:not(.is-scrolled) .hdr__nav a[aria-current='page'] { color: #fff; text-decoration: underline; text-underline-offset: 8px; }
  .hdr__actions { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .lang { display: flex; flex: none; white-space: nowrap; list-style: none; align-items: center; font-size: .8125rem; font-weight: 700; letter-spacing: .06em; color: #fff; }
  .lang li + li::before { content: '|'; opacity: .35; margin: 0 2px; }
  .lang a { display: inline-grid; place-items: center; min-width: 30px; height: 26px; border-radius: 6px; text-decoration: none; opacity: .6; transition: opacity .2s, background .2s; }
  .lang a:hover { opacity: 1; }
  .lang a[aria-current='true'] { opacity: 1; background: rgba(255, 255, 255, 0.16); }
  .hdr__icon { display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 10px; background: #fff; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-strong); transition: box-shadow .2s; }
  .hdr__icon:hover { box-shadow: inset 0 0 0 1px var(--ink); }
  .hdr--dark:not(.is-scrolled) .hdr__icon { background: rgba(255, 255, 255, 0.08); color: #fff; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.3); }
  .hdr__cta { display: none; min-height: 46px; padding: 0 20px; }
  .hdr__burger { display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 10px; background: transparent; border: 0; color: inherit; }
  .burger { display: grid; gap: 5px; width: 22px; }
  .burger span { display: block; height: 2px; background: currentColor; border-radius: 2px; }
  @media (max-width: 719px) { .hdr__icon { display: none; } .hdr__g1, .hdr__gdot { display: none; } }
  @media (min-width: 720px) { .hdr__cta { display: inline-flex; } }
  @media (min-width: 900px) { .hdr__pill { display: inline-flex; } }
  @media (min-width: 1280px) {
    .hdr__nav { display: flex; }
    .hdr__burger { display: none; }
  }
  @media (min-width: 1280px) and (max-width: 1499px) {
    .hdr__low, .hdr__icon { display: none !important; }
    .hdr__nav a { font-size: .9063rem; }
    .hdr__inner { gap: 12px; }
    .hdr__pill { padding: 0 12px; }
    .hdr__logo :global(.logo__sub) { display: none; }
  }

  /* Mobile menu */
  .mm { position: fixed; inset: 0; z-index: 80; background: #fff; color: var(--ink); display: flex; flex-direction: column; overflow-y: auto; overscroll-behavior: contain; }
  .mm__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; flex: none; border-bottom: 1px solid var(--line); }
  .mm__close { width: 46px; height: 46px; display: grid; place-items: center; margin-right: -6px; background: var(--bg); border: 0; border-radius: 10px; color: var(--ink); }
  .mm__body { flex: 1; padding-top: 20px; display: grid; align-content: start; gap: 20px; }
  .mm__lang { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; list-style: none; }
  .mm__lang a { display: grid; justify-items: center; gap: 2px; padding: 10px 6px; border-radius: 12px; background: var(--bg); text-decoration: none; font-family: var(--font-display); font-weight: 800; font-size: 1rem; }
  .mm__lang a span { font-family: var(--font-body); font-weight: 500; font-size: .75rem; color: var(--muted); }
  .mm__lang a[aria-current='true'] { background: var(--brand); color: #fff; }
  .mm__lang a[aria-current='true'] span { color: rgba(255,255,255,.8); }
  .mm__nav { list-style: none; }
  .mm__nav li { border-bottom: 1px solid var(--line); }
  .mm__nav a { display: flex; justify-content: space-between; align-items: center; padding: 16px 2px; text-decoration: none; font-family: var(--font-display); font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; }
  .mm__nav a :global(svg) { color: var(--muted); }
  .mm__nav a[aria-current='page'] { color: var(--brand); }
  .mm__foot { display: grid; gap: 10px; padding-top: 20px; padding-bottom: calc(20px + env(safe-area-inset-bottom)); position: sticky; bottom: 0; background: linear-gradient(180deg, rgba(255,255,255,0), #fff 24%); }
  @media (prefers-reduced-motion: no-preference) {
    :global(.mm.is-open) .mm__nav li { animation: mmIn .5s var(--ease) both; animation-delay: calc(var(--i) * 35ms + 40ms); }
    @keyframes mmIn { from { opacity: 0; transform: translateY(10px); } }
  }
</style>
