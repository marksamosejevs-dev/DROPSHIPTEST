---
/**
 * Multi-step lead form (address → consumption → interests → contact).
 * Only data needed to prepare an estimate is collected. No marketing consent
 * is bundled with the request. If marketing e-mails/SMS are added later, add a
 * SEPARATE, optional, unticked checkbox — never pre-ticked, never required.
 */
import Icon from './Icon.astro';
import { useT, path, units, type Locale } from '../i18n';
import { integrations } from '../config/company';
import { calculatorAssumptions as A } from '../data/calculator';

interface Props { lang: Locale; id?: string; tone?: 'light' | 'dark'; source?: string }
const { lang, id = 'lead', tone = 'light', source = 'form' } = Astro.props;
const t = useT(lang);
const f = t.form;
const total = 4;
const interests = Object.entries(f.interestOptions) as [string, string][];
const interestIcons: Record<string, string> = { solar: 'panel', battery: 'battery', ev: 'ev', consult: 'phone' };
---
<form
  class:list={['lf', `lf--${tone}`]}
  id={id}
  method="post"
  action={integrations.leadEndpoint || undefined}
  novalidate
  data-lead-form
  data-endpoint={integrations.leadEndpoint}
  data-errors={JSON.stringify(f.errors)}
  data-sending={f.sending}
  data-step="1"
>
  <div class="lf__head">
    <p class="lf__title">{f.title}</p>
    <p class="lf__quick"><Icon name="clock" size={16} />{f.quick}</p>
  </div>
  <div class="lf__progress" aria-hidden="true">
    {f.steps.map((s, i) => <span class="lf__pstep" data-pstep={i + 1}><i></i><em>{s}</em></span>)}
  </div>
  <p class="lf__stepof sr-only" aria-live="polite" data-stepof data-template={f.stepOf(0, total)}>{f.stepOf(1, total)}</p>

  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="source" value={source} />
  <input type="hidden" name="package" value="" data-prefill="package" />
  <input type="hidden" name="page" value="" data-prefill="page" />
  <div class="lf__hp" aria-hidden="true"><label>{/* honeypot: hidden from people and assistive tech */}Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

  <!-- STEP 1 -->
  <fieldset class="lf__step" data-step-panel="1">
    <legend class="lf__legend"><span class="tnum">01</span>{f.address}</legend>
    <div class="field">
      <label for={`${id}-address`} class="sr-only">{f.address}</label>
      <div class="lf__iconinput"><Icon name="pin" size={20} />
        <input class="input" id={`${id}-address`} name="address" type="text" autocomplete="street-address" placeholder={f.addressPh} required minlength="2" aria-describedby={`${id}-address-hint ${id}-address-err`} data-validate="address" />
      </div>
      <p class="field-hint" id={`${id}-address-hint`}>{f.addressHint}</p>
      <p class="field-error" id={`${id}-address-err`} data-error-for="address"></p>
    </div>
  </fieldset>

  <!-- STEP 2 -->
  <fieldset class="lf__step" data-step-panel="2">
    <legend class="lf__legend"><span class="tnum">02</span>{f.usageMode}</legend>
    <div class="lf__seg" role="radiogroup">
      <label><input type="radio" name="usageUnit" value="kwh" checked data-unit /><span>{f.usageKwh}</span></label>
      <label><input type="radio" name="usageUnit" value="eur" data-unit /><span>{f.usageBill}</span></label>
    </div>
    <div class="field">
      <label for={`${id}-usage`} data-usage-label data-kwh={f.usageLabelKwh} data-eur={f.usageLabelBill}>{f.usageLabelKwh}</label>
      <div class="lf__iconinput lf__iconinput--unit">
        <input class="input tnum" id={`${id}-usage`} name="usage" type="number" inputmode="decimal" min="1" max="100000" placeholder={String(A.defaultConsumption)} aria-describedby={`${id}-usage-err`} data-validate="usage" data-prefill="kwh" />
        <span class="lf__unit" data-unit-label data-kwh={units[lang].kwh} data-eur="€">{units[lang].kwh}</span>
      </div>
      <p class="field-error" id={`${id}-usage-err`} data-error-for="usage"></p>
    </div>
    <label class="lf__check lf__check--inline"><input type="checkbox" name="usageUnknown" value="1" data-usage-unknown /><span class="lf__box" aria-hidden="true"><Icon name="check" size={14} /></span><span>{f.usageUnknown}</span></label>
  </fieldset>

  <!-- STEP 3 -->
  <fieldset class="lf__step" data-step-panel="3" aria-describedby={`${id}-interests-err`}>
    <legend class="lf__legend"><span class="tnum">03</span>{f.interests}</legend>
    <div class="lf__tiles">
      {interests.map(([k, label]) => (
        <label class="lf__tile">
          <input type="checkbox" name="interests" value={k} data-validate="interests" data-prefill-interest={k} />
          <span class="lf__tileui">
            <Icon name={interestIcons[k]} size={22} />
            <span>{label}</span>
            <span class="lf__box" aria-hidden="true"><Icon name="check" size={14} /></span>
          </span>
        </label>
      ))}
    </div>
    <p class="field-error" id={`${id}-interests-err`} data-error-for="interests"></p>
  </fieldset>

  <!-- STEP 4 -->
  <fieldset class="lf__step" data-step-panel="4">
    <legend class="lf__legend"><span class="tnum">04</span>{f.steps[3]}</legend>
    <div class="lf__fields">
      <div class="field">
        <label for={`${id}-name`}>{f.name}</label>
        <input class="input" id={`${id}-name`} name="name" type="text" autocomplete="name" required aria-describedby={`${id}-name-err`} data-validate="name" />
        <p class="field-error" id={`${id}-name-err`} data-error-for="name"></p>
      </div>
      <div class="field">
        <label for={`${id}-phone`}>{f.phone}</label>
        <input class="input" id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+371" required aria-describedby={`${id}-phone-err`} data-validate="phone" />
        <p class="field-error" id={`${id}-phone-err`} data-error-for="phone"></p>
      </div>
      <div class="field lf__full">
        <label for={`${id}-email`}>{f.email}</label>
        <input class="input" id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" required aria-describedby={`${id}-email-err`} data-validate="email" />
        <p class="field-error" id={`${id}-email-err`} data-error-for="email"></p>
      </div>
    </div>
    <p class="lf__privacy">
      {f.privacy.before}<a href={path('privacy', lang)} target="_blank" rel="noopener">{f.privacy.link}</a>{f.privacy.after}
    </p>
  </fieldset>

  <p class="field-error lf__submit-err" role="alert" data-submit-error></p>

  <div class="lf__nav">
    <button type="button" class="btn btn--ghost lf__back" data-back hidden>{f.back}</button>
    <button type="button" class="btn lf__next" data-next>{f.next}<Icon name="arrow" /></button>
    <button type="submit" class="btn lf__submit" data-submit>{f.submit}<Icon name="arrow" /></button>
  </div>

  <div class="lf__done" data-done hidden tabindex="-1">
    <span class="lf__doneicon"><Icon name="check" size={28} /></span>
    <p class="lf__donetitle">{f.success.title}</p>
    <p>{f.success.text}</p>
    <p class="dev-note" data-dev-note hidden>{f.success.dev}</p>
  </div>
</form>

<script>
  import '../scripts/lead-form';
</script>

<style>
  .lf { --surface: #fff; --fg: var(--ink); position: relative; display: grid; gap: 22px; padding: clamp(22px, 3.4vw, 36px); border-radius: 16px; background: var(--surface); color: var(--fg); box-shadow: var(--shadow-card), 0 0 0 1px var(--line); }
  .lf__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .lf__title { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; letter-spacing: -0.02em; }
  .lf__quick { display: inline-flex; align-items: center; gap: 6px; font-size: .8125rem; color: var(--muted); white-space: nowrap; }
  .lf__progress { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  .lf__pstep { display: grid; gap: 8px; }
  .lf__pstep i { display: block; height: 3px; border-radius: 3px; background: var(--stone); overflow: hidden; position: relative; }
  .lf__pstep i::after { content: ''; position: absolute; inset: 0; background: var(--moss); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); }
  .lf__pstep.is-done i::after, .lf__pstep.is-active i::after { transform: scaleX(1); }
  .lf__iconinput--unit .input { -moz-appearance: textfield; appearance: textfield; }
  .lf__iconinput--unit .input::-webkit-inner-spin-button, .lf__iconinput--unit .input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .lf__pstep { min-width: 0; }
  .lf__pstep em { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-style: normal; font-size: .75rem; color: var(--muted-2); font-weight: 500; }
  .lf__pstep.is-active em, .lf__pstep.is-done em { color: var(--ink); }
  .lf__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf__step { border: 0; margin: 0; padding: 0; display: grid; gap: 16px; min-width: 0; }
  :global(.js) .lf__step:not(.is-active) { display: none; }
  :global(.js) .lf__step.is-active { animation: stepFade .45s var(--ease); }
  @keyframes stepFade { from { opacity: 0; transform: translateX(12px); } }
  .lf__legend { display: flex; gap: 12px; align-items: baseline; font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; letter-spacing: -0.015em; padding: 0; margin-bottom: 4px; }
  .lf__legend span { font-family: var(--font-body); font-size: .75rem; color: var(--moss); letter-spacing: .08em; }
  .lf__iconinput { position: relative; }
  .lf__iconinput :global(svg) { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none; }
  .lf__iconinput .input { padding-left: 46px; }
  .lf__iconinput--unit .input { padding-left: 16px; padding-right: 64px; font-size: 1.25rem; font-weight: 600; }
  .lf__unit { position: absolute; right: 16px; top: 50%; transform: translateY(-50%); color: var(--muted); font-weight: 500; }
  .lf__seg { display: inline-flex; justify-self: start; padding: 4px; border-radius: 10px; background: var(--sand); gap: 4px; }
  .lf__seg label { position: relative; }
  .lf__seg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .lf__seg span { display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 7px; font-size: .9375rem; font-weight: 600; color: var(--muted); }
  .lf__seg input:checked + span { background: #fff; color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .lf__seg input:focus-visible + span { outline: 2px solid var(--moss); outline-offset: 2px; }
  .lf__check { display: flex; align-items: center; gap: 12px; cursor: pointer; font-size: .9375rem; position: relative; }
  .lf__check input { position: absolute; opacity: 0; width: 22px; height: 22px; margin: 0; }
  .lf__box { width: 22px; height: 22px; flex: none; border-radius: 6px; border: 1.5px solid var(--line-strong); display: grid; place-items: center; color: transparent; background: #fff; transition: background .2s, border-color .2s, color .2s; }
  .lf__check input:checked + .lf__box { background: var(--ink); border-color: var(--ink); color: #fff; }
  .lf__check input:focus-visible + .lf__box { outline: 2px solid var(--moss); outline-offset: 2px; }
  .lf__tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .lf__tile { position: relative; }
  .lf__tile input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; z-index: 1; }
  .lf__tileui { position: relative; display: grid; gap: 12px; align-content: start; min-height: 112px; padding: 16px; border-radius: 12px; border: 1.5px solid var(--line); background: #fff; font-weight: 600; font-size: .9375rem; line-height: 1.3; transition: border-color .2s, background .2s, box-shadow .2s; }
  .lf__tileui > :global(svg) { color: var(--moss); }
  .lf__tileui .lf__box { position: absolute; right: 12px; top: 12px; }
  .lf__tile:hover .lf__tileui { border-color: var(--line-strong); }
  .lf__tile input:checked + .lf__tileui { border-color: var(--ink); background: #f7f8f5; box-shadow: 0 0 0 1px var(--ink); }
  .lf__tile input:checked + .lf__tileui .lf__box { background: var(--ink); border-color: var(--ink); color: #fff; }
  .lf__tile input:focus-visible + .lf__tileui { outline: 2px solid var(--moss); outline-offset: 2px; }
  .lf__fields { display: grid; gap: 14px; }
  @media (min-width: 560px) { .lf__fields { grid-template-columns: 1fr 1fr; } .lf__full { grid-column: 1 / -1; } }
  .lf__privacy { font-size: .8125rem; color: var(--muted); line-height: 1.5; }
  .lf__privacy a { color: var(--ink); font-weight: 500; }
  .lf__nav { display: flex; gap: 10px; }
  .lf__nav .btn { flex: 1; min-height: 56px; }
  .lf__back { flex: 0 0 auto !important; }
  :global(.js) .lf[data-step='1'] .lf__submit, :global(.js) .lf[data-step='2'] .lf__submit, :global(.js) .lf[data-step='3'] .lf__submit { display: none; }
  :global(.js) .lf[data-step='4'] .lf__next { display: none; }
  :global(.no-js) .lf__next, :global(.no-js) .lf__back, :global(.no-js) .lf__progress { display: none; }
  .lf__submit { --bg: var(--brand); --fg: #fff; --bd: var(--brand); box-shadow: var(--shadow-btn); }
  .lf__submit:hover { --bg: var(--brand-hover); --bd: var(--brand-hover); }
  .lf__done { display: grid; gap: 12px; justify-items: start; padding: 12px 0; }
  .lf__done:focus { outline: none; }
  .lf__doneicon { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: #fff; }
  .lf__donetitle { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; letter-spacing: -0.02em; }
  :global(.lf.is-done) > :not(.lf__done) { display: none !important; }
</style>
