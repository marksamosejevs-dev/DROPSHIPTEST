---
import Icon from './Icon.astro';
import { useT, path, type Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const t = useT(lang);
---
<div class="mcta" data-mobile-cta aria-hidden="true">
  <a href={path('calculator', lang)} class="mcta__calc" tabindex="-1">
    <Icon name="chart" size={20} /><span class="mcta__label">{t.nav.calculator}</span>
  </a>
  <a href={path('offer', lang)} class="btn btn--volt mcta__offer" tabindex="-1" data-cta="mobile-bar">{t.cta.offer}<Icon name="arrow" /></a>
</div>

<style>
  .mcta {
    position: fixed; z-index: 45; left: 10px; right: 10px; bottom: calc(10px + env(safe-area-inset-bottom));
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px; padding: 8px;
    background: rgba(11, 20, 16, 0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-radius: 14px; box-shadow: 0 16px 40px -12px rgba(0,0,0,.5);
    transform: translateY(calc(100% + 24px)); transition: transform .5s var(--ease);
  }
  :global(.mcta.is-visible) { transform: none; }
  .mcta__calc { display: flex; align-items: center; gap: 8px; padding: 0 14px; color: #fff; text-decoration: none; font-size: .875rem; font-weight: 500; border-radius: 8px; border: 1px solid var(--line-inv); }
  .mcta__offer { min-height: 48px; padding-inline: 14px; }
  @media (max-width: 429px) { .mcta__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .mcta__calc { padding: 0 13px; } }
  @media (min-width: 720px) { .mcta { display: none; } }
</style>
