---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { useT, path, locales, localeMeta } from '../i18n';
const lang = 'lv';
const t = useT(lang);
---
<Base lang={lang} route={null} title={t.meta.notFound.title} description={t.meta.notFound.description} headerTone="light" noindex>
  <section class="nf">
    <div class="container nf__inner">
      <p class="nf__code tnum">404</p>
      {locales.map((l) => {
        const d = useT(l);
        return (
          <div class="nf__row" lang={localeMeta[l].htmlLang}>
            <h1 class="nf__title">{d.pages.notFound.title}</h1>
            <p class="muted">{d.pages.notFound.text}</p>
            <a href={path('home', l)} class="link-arrow">{d.cta.back}<Icon name="arrow" /></a>
          </div>
        );
      })}
    </div>
  </section>
</Base>
<style>
  .nf { padding: calc(var(--header-h) + 80px) 0 120px; min-height: 80svh; }
  .nf__inner { display: grid; gap: 32px; }
  .nf__code { font-family: var(--font-display); font-size: clamp(6rem, 18vw, 14rem); font-weight: 600; letter-spacing: -0.06em; line-height: .9; color: var(--stone); }
  .nf__row { display: grid; gap: 8px; justify-items: start; padding-top: 24px; border-top: 1px solid var(--line); }
  .nf__title { font-size: 1.6rem; }
  .nf__row + .nf__row .nf__title { font-size: 1.2rem; }
</style>
