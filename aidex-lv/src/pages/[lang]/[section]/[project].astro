---
/** Case-study pages: /{lang}/{projects-slug}/{project-slug}/ — one per visible project. */
import { locales, routes } from '../../../i18n/routes';
import { visibleProjects } from '../../../data/projects';
import ProjectDetail from '../../../views/ProjectDetail.astro';

export function getStaticPaths() {
  return locales.flatMap((lang) => visibleProjects().map((project) => ({
    params: { lang, section: routes.projects[lang], project: project.slug },
    props: { lang, project },
  })));
}
const { lang, project } = Astro.props;
---
<ProjectDetail lang={lang} project={project} />
